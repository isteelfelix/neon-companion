<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.isteelfelix.neoncompanion">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- For file picking on older Android; modern uses ACTION_OPEN_DOCUMENT which doesn't require these -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/app_icon"
        android:theme="@style/UnityThemeSelector"
        android:debuggable="false">

        <activity android:name="com.unity3d.player.UnityPlayerActivity"
            android:label="@string/app_name"
            android:screenOrientation="fullSensor"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:hardwareAccelerated="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

            <activity android:name="com.neoncompanion.speech.NeonSpeechRecognitionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

            <activity android:name="com.neoncompanion.filepicker.NeonFilePickerActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />
    </application>
</manifest>