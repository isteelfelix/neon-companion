/* Terminal panel styles — runtime-loaded by ChatView.uxml. */

.right-panel-tabs {
    height: 32px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px;
    background-color: var(--bg-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
}

.right-panel-tab {
    height: 24px;
    flex-grow: 1;
    flex-basis: 0;
    padding: 0;
    margin: 0 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--r-sm);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-3);
    font-size: 11px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.right-panel-tab:hover {
    background-color: var(--bg-3);
    color: var(--text-1);
}

.right-panel-tab--active {
    background-color: var(--bg-3);
    border-color: var(--line-2);
    color: var(--text-0);
    -unity-font-style: bold;
}

.right-panel-content,
.terminal-host {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.terminal-host {
    background-color: var(--bg-1);
}

.terminal-tabs {
    height: 32px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 4px;
    background-color: var(--bg-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
}

.terminal-tabs__scroll {
    flex-grow: 1;
    min-width: 0;
    height: 24px;
    flex-shrink: 1;
}

.terminal-tabs__list {
    height: 24px;
    flex-direction: row;
    align-items: center;
}

.terminal-tabs__add {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 4px;
    padding: 0;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: var(--r-sm);
    background-color: var(--bg-2);
    color: var(--text-2);
    font-size: 16px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.terminal-tabs__add:hover {
    background-color: var(--bg-3);
    border-color: var(--line-3);
    color: var(--text-0);
}

.terminal-tab {
    width: 50px;
    height: 24px;
    min-width: 50px;
    max-width: 50px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px 0 7px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--r-sm);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-3);
}

.terminal-tab:hover {
    background-color: var(--bg-2);
    color: var(--text-1);
}

.terminal-tab--active {
    background-color: var(--accent-soft);
    border-color: var(--accent-glow);
    color: var(--accent-text);
}

.terminal-tab--agent {
    border-left-width: 2px;
    border-left-color: var(--warn);
}

.terminal-tab__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Icons/terminal.svg");
    -unity-background-image-tint-color: var(--text-3);
}

.terminal-tab:hover .terminal-tab__icon {
    -unity-background-image-tint-color: var(--text-1);
}

.terminal-tab--active .terminal-tab__icon {
    -unity-background-image-tint-color: var(--accent-text);
}

.terminal-tab__close {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-left: 2px;
    padding: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-3);
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.terminal-tab__close:hover {
    background-color: rgba(226, 112, 71, 0.18);
    color: var(--danger);
}

.terminal-panes,
.terminal-pane-host,
.terminal-pane,
.terminal-screen {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.terminal-panes {
    background-color: var(--bg-2);
}

.terminal-screen {
    padding: 6px 6px;
    background-color: var(--bg-2);
}

.terminal-screen__rows {
    flex-grow: 1;
    flex-direction: column;
}

.terminal-screen__message {
    color: var(--text-2);
}

.terminal-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--bg-2);
    overflow: hidden;
}

.terminal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 5px 8px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    background-color: var(--bg-1);
}

.terminal-title {
    color: var(--text-0);
    font-size: 12px;
    -unity-font-style: bold;
}

.terminal-status {
    color: var(--text-2);
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    padding: 1px 6px;
    border-radius: 4px;
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
}

.terminal-output-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
    background-color: var(--bg-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    padding: 6px 8px;
}

.terminal-output {
    color: var(--text-1);
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    white-space: normal;
    -unity-text-align: upper-left;
}

.terminal-input-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    flex-shrink: 0;
    background-color: var(--bg-2);
}

.terminal-input {
    flex-grow: 1;
    margin-right: 6px;
    background-color: var(--bg-0);
    color: var(--text-0);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.terminal-submit-btn {
    flex-shrink: 0;
    padding: 4px 10px;
    font-size: 11px;
}
