/* ============== Shared components ==============
   Maps 1:1 to the design system: btn, iconbtn, chip, input, label, kbd, toggle.
*/

/* ---- typography defaults ---- */
.text-mono {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ---- buttons ---- */
.btn {
    height: 32px;
    padding: 0 14px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: var(--bg-2);
    color: var(--text-1);
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
    white-space: nowrap;
}
.btn:hover {
    background-color: var(--bg-3);
    color: var(--text-0);
    border-color: var(--line-3);
}
.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}
.btn--ghost:hover {
    background-color: var(--bg-2);
    border-color: var(--line-2);
}
.btn--primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: rgb(255, 255, 255);
}
.btn--primary:hover {
    background-color: #8E8CFA;
    border-color: #8E8CFA;
}
.btn--lg {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
}

/* ---- icon button (square, ghost) ---- */
.iconbtn {
    width: 30px;
    height: 30px;
    padding: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
    -unity-text-align: middle-center;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}
.iconbtn:hover {
    background-color: var(--bg-3);
    color: var(--text-0);
}

/* ---- chip ---- */
.chip {
    height: 24px;
    padding: 0 9px;
    border-radius: 999px;
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    color: var(--text-2);
    font-size: 11px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    flex-direction: row;
    align-items: center;
}
.chip--accent {
    background-color: var(--accent-soft);
    border-color: var(--accent-glow);
    color: var(--accent-text);
}
.chip--ok {
    color: var(--ok);
}

/* ---- input ---- */
.input > .unity-text-field__input,
.input > .unity-base-text-field__input {
    height: 36px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 0 12px;
    color: var(--text-1);
    font-size: 13px;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}
.input:focus > .unity-text-field__input,
.input:focus > .unity-base-text-field__input {
    border-color: var(--accent);
    background-color: var(--bg-1);
}
.input--mono > .unity-text-field__input,
.input--mono > .unity-base-text-field__input {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 12px;
}

/* ---- label ---- */
.label {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 10px;
    -unity-font-style: normal;
    letter-spacing: 1px;
    color: var(--text-3);
    margin-bottom: 6px;
}

/* ---- kbd ---- */
.kbd {
    padding: 1px 5px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 10px;
    color: var(--text-2);
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    border-bottom-width: 2px;
    border-radius: 4px;
    min-width: 16px;
    -unity-text-align: middle-center;
}

/* ---- typography utilities ---- */
.h1 {
    font-size: 24px;
    color: var(--text-0);
    -unity-font-style: bold;
    margin-bottom: 6px;
}
.h2 {
    font-size: 16px;
    color: var(--text-0);
    -unity-font-style: bold;
}
.h3 {
    font-size: 14px;
    color: var(--text-0);
    -unity-font-style: bold;
}
.subtle {
    font-size: 13px;
    color: var(--text-3);
}

/* ---- card ---- */
.card {
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: var(--r-lg);
    padding: 16px;
}
.card--padded {
    padding: 20px;
}

/* ---- dot indicator ---- */
.dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
}
.dot--ok   { background-color: var(--ok); }
.dot--warn { background-color: var(--warn); }
.dot--err  { background-color: var(--danger); }

/* ---- scrollbar ---- */
.unity-scroller--vertical {
    width: 8px;
}
.unity-scroller--vertical > .unity-repeat-button {
    display: none;
}
.unity-scroller__slider {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}
.unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    border-width: 0;
    min-height: 32px;
    margin: 0;
    left: 0;
    width: 8px;
}
.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.22);
}

/* ---- toggle (visual only, no Toggle element) ---- */
.toggle {
    width: 36px;
    height: 20px;
    border-radius: 999px;
    background-color: var(--bg-4);
    border-width: 1px;
    border-color: var(--line-2);
    align-items: center;
    justify-content: flex-start;
    flex-direction: row;
    padding: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.toggle__knob {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background-color: var(--text-2);
    margin-left: 2px;
    margin-top: 2px;
    transition-property: translate, background-color;
    transition-duration: 0.18s;
}
.toggle--on {
    background-color: var(--accent);
    border-color: var(--accent);
}
.toggle--on > .toggle__knob {
    background-color: rgb(255, 255, 255);
    translate: 16px 0;
}
