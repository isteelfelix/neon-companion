/* ============== Shared components ==============
   Maps 1:1 to the design system: btn, iconbtn, chip, input, label, kbd, toggle.
*/

/* ---- typography defaults ---- */
.text-mono {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ---- buttons ---- */
.btn {
    height: 26px;
    padding: 0 10px;
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: var(--bg-2);
    color: var(--text-1);
    font-size: 12px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
    white-space: nowrap;
}
.btn:hover {
    background-color: var(--bg-3);
    color: var(--text-0);
    border-color: var(--line-3);
}
.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}
.btn--ghost:hover {
    background-color: var(--bg-2);
    border-color: var(--line-2);
}
.btn--primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: rgb(255, 255, 255);
}
.btn--primary:hover {
    background-color: #8E8CFA;
    border-color: #8E8CFA;
}
.btn--lg {
    height: 32px;
    padding: 0 14px;
    font-size: 13px;
}

/* ---- icon button (square, ghost) ---- */
.iconbtn {
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}
.iconbtn:hover {
    background-color: var(--bg-3);
    color: var(--text-0);
}

/* ---- chip ---- */
.chip {
    height: 20px;
    padding: 0 7px;
    border-radius: 6px;
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    color: var(--text-2);
    font-size: 10px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    flex-direction: row;
    align-items: center;
}
.chip--accent {
    background-color: var(--accent-soft);
    border-color: var(--accent-glow);
    color: var(--accent-text);
}
.chip--ok {
    color: var(--ok);
}

/* ---- input ---- */
.input > .unity-text-field__input,
.input > .unity-base-text-field__input {
    height: 28px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 7px;
    padding: 0 9px;
    color: var(--text-1);
    font-size: 12px;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}
.input:focus > .unity-text-field__input,
.input:focus > .unity-base-text-field__input {
    border-color: var(--accent);
    background-color: var(--bg-1);
}
.input--mono > .unity-text-field__input,
.input--mono > .unity-base-text-field__input {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 12px;
}

/* ---- label ---- */
.label {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 10px;
    -unity-font-style: normal;
    letter-spacing: 1px;
    color: var(--text-3);
    margin-bottom: 4px;
}

/* ---- kbd ---- */
.kbd {
    padding: 1px 5px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 10px;
    color: var(--text-2);
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    border-bottom-width: 2px;
    border-radius: 4px;
    min-width: 16px;
    -unity-text-align: middle-center;
}

/* ---- typography utilities ---- */
.h1 {
    font-size: 18px;
    color: var(--text-0);
    -unity-font-style: bold;
    margin-bottom: 4px;
}
.h2 {
    font-size: 14px;
    color: var(--text-0);
    -unity-font-style: bold;
}
.h3 {
    font-size: 13px;
    color: var(--text-0);
    -unity-font-style: bold;
}
.subtle {
    font-size: 12px;
    color: var(--text-3);
}

/* ---- card ---- */
.card {
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: var(--r-lg);
    padding: 12px 14px;
}
.card--padded {
    padding: 16px;
}

/* ---- dot indicator ---- */
.dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
}
.dot--ok   { background-color: var(--ok); }
.dot--warn { background-color: var(--warn); }
.dot--err  { background-color: var(--danger); }

/* ---- NeonDropdown (custom dropdown, replaces Unity DropdownField) ---- */
.neon-dropdown {
    flex-direction: column;
    flex-shrink: 0;
}

.neon-dropdown__trigger {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px 0 9px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: var(--r-md);
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.neon-dropdown__trigger:hover {
    border-color: var(--line-3);
    background-color: var(--bg-3);
}

.neon-dropdown--open .neon-dropdown__trigger {
    border-color: var(--accent);
}

.neon-dropdown__value {
    flex-grow: 1;
    color: var(--text-1);
    font-size: 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.neon-dropdown__arrow {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-left: 6px;
    background-image: url("project://database/Assets/UI/Icons/arrow.svg");
    -unity-background-image-tint-color: var(--text-3);
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    /* arrow.svg is a right chevron (>); 90° points it down (caret). */
    rotate: 90deg;
    transition-property: rotate;
    transition-duration: 0.15s;
}

.neon-dropdown--open .neon-dropdown__arrow {
    rotate: 270deg;
}

/* Popup overlay — added to panel.visualTree, always on top */
.neon-dropdown__popup {
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: var(--r-md);
    padding: 4px;
}

.neon-dropdown__scroll {
    max-height: 260px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

.neon-dropdown__list {
    flex-direction: column;
}

.neon-dropdown__item {
    height: 24px;
    padding: 0 8px;
    border-radius: var(--r-sm);
    color: var(--text-1);
    font-size: 12px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.neon-dropdown__item--hover {
    background-color: var(--bg-4);
}

.neon-dropdown__item--selected {
    color: var(--accent-text);
    background-color: var(--accent-soft);
}

/* When NeonDropdown carries .input class — match TextField height */
.input.neon-dropdown .neon-dropdown__trigger {
    height: 28px;
}

/* ---- scrollbar ---- */
.unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.unity-scroller > .unity-repeat-button {
    display: none;
}
.unity-scroller--vertical {
    width: 8px;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller--horizontal {
    height: 8px;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller__slider {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}
.unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    border-width: 0;
    min-height: 32px;
    margin: 0;
    left: 0;
    width: 8px;
}
.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.22);
}
.unity-scroller--horizontal .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    border-width: 0;
    min-width: 32px;
    margin: 0;
    top: 0;
    height: 8px;
}
.unity-scroller--horizontal .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.22);
}

/* ---- modal overlay ---- */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.62);
    align-items: center;
    justify-content: center;
    padding: 16px;
}

.modal {
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: var(--r-xl);
    padding: 14px 16px;
    flex-direction: column;
}

/* ---- model picker ---- */
.model-picker {
    width: 480px;
    max-width: 100%;
    max-height: 560px;
}

.model-picker__header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
}

.model-picker__title-wrap {
    flex-grow: 1;
    flex-direction: column;
}

.model-picker__title {
    font-size: 15px;
    color: var(--text-0);
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.model-picker__subtitle {
    font-size: 12px;
    color: var(--text-3);
    white-space: normal;
}

.model-picker__status {
    font-size: 12px;
    color: var(--ok);
    white-space: normal;
    margin-bottom: 10px;
    margin-top: 6px;
}

.model-picker__scroll {
    flex-grow: 1;
    max-height: 440px;
}

.model-picker__group {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 6px;
    border-radius: var(--r-sm);
    border-width: 0;
    background-color: transparent;
    color: var(--text-4);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-top: 6px;
    margin-bottom: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.model-picker__group:hover {
    background-color: var(--bg-2);
    color: var(--text-2);
}

.model-picker__group-arrow {
    font-size: 9px;
    color: var(--text-3);
    margin-right: 8px;
    width: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.model-picker__group-label {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.model-picker__items {
    margin-bottom: 3px;
    padding-left: 14px;
}

.model-picker__item {
    min-height: 26px;
    padding: 4px 8px;
    border-radius: var(--r-sm);
    border-width: 0;
    background-color: transparent;
    color: var(--text-1);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: normal;
    margin-bottom: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.model-picker__item:hover {
    background-color: var(--bg-3);
    color: var(--text-0);
}

.model-picker__item--selected {
    background-color: var(--accent-soft);
    border-width: 1px;
    border-color: var(--accent-glow);
    color: var(--accent-text);
}

.model-picker__item--locked {
    opacity: 0.4;
}

.model-picker__group--active {
    border-left-width: 2px;
    border-left-color: var(--accent-glow);
}

.model-picker__warning {
    font-size: 11px;
    color: var(--warn);
    padding: 4px 8px;
    margin-bottom: 4px;
}

/* ---- resize handle ---- */
.resize-handle {
    width: 5px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.resize-handle:hover {
    background-color: rgba(124, 122, 237, 0.22);
}

.resize-handle--active {
    background-color: rgba(124, 122, 237, 0.40);
}

/* ---- toggle (visual only, no Toggle element) ---- */
.toggle {
    width: 36px;
    min-width: 36px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 10px;
    background-color: var(--bg-4);
    border-width: 1px;
    border-color: var(--line-2);
    align-items: center;
    justify-content: flex-start;
    flex-direction: row;
    padding: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.toggle__knob {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background-color: var(--text-2);
    margin-left: 2px;
    margin-top: 2px;
    transition-property: translate, background-color;
    transition-duration: 0.18s;
}
.toggle--on {
    background-color: var(--accent);
    border-color: var(--accent);
}
.toggle--on > .toggle__knob {
    background-color: rgb(255, 255, 255);
    translate: 16px 0px;
}
