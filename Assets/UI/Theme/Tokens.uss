/* ============== Neon Companion — design tokens ==============
   Conversion notes:
   - oklch(...) → approximated hex (UITK has no oklch).
   - accent  oklch(0.68 0.18 268) ≈ #7C7AED  (indigo)
   - accent2 oklch(0.74 0.18 295) ≈ #A285F0  (violet)
   - ok      oklch(0.78 0.16 152) ≈ #4DCB85
   - warn    oklch(0.82 0.16 75)  ≈ #E5B25C
   - danger  oklch(0.7  0.20 25)  ≈ #E27047
   - text-on-accent oklch(0.86 0.1 268) ≈ #C7C5FF
*/

* {
    /* surfaces */
    --bg-0: #0B0C10;
    --bg-1: #101218;
    --bg-2: #16181F;
    --bg-3: #1C1F27;
    --bg-4: #232732;

    /* lines */
    --line-1: #232733;
    --line-2: #2D3240;
    --line-3: #3A4052;

    /* text */
    --text-0: #F3F5FA;
    --text-1: #D8DCE6;
    --text-2: #9AA2B3;
    --text-3: #6B7387;
    --text-4: #4A5163;

    /* accent (indigo→violet) */
    --accent: #7C7AED;
    --accent-2: #A285F0;
    --accent-soft: rgba(124, 122, 237, 0.16);
    --accent-glow: rgba(124, 122, 237, 0.40);
    --accent-text: #C7C5FF;

    /* semantic */
    --ok: #4DCB85;
    --warn: #E5B25C;
    --danger: #E27047;
    --ok-soft: rgba(77, 203, 133, 0.16);

    /* radii */
    --r-sm: 5px;
    --r-md: 8px;
    --r-lg: 10px;
    --r-xl: 14px;
    --r-pill: 999px;
}

/* ============== Density scale ==============
   USS has no calc()/gap, and var() in shorthands is a silent-failure risk
   (Unity drops the whole rule block), so spacing is written as literals.
   Keep new UI on this scale instead of inventing values:

     space   2 / 4 / 6 / 8 / 10 / 12 / 14 / 20
     control heights   sm 22  ·  md 26  ·  lg 32
     row heights       nav/list 26  ·  topbar 40
     page padding      16px 20px          (phone: 10px 12px)
     card padding      12px 14px
     font sizes        micro 9-10 · small 11 · body 12 · title 13-14 · page 18

   Anything larger than this is a deliberate exception (avatar hero, modals).

   IMPORTANT — why single-line labels carry an explicit `height`:
   UITK has no line-height property, and a Label's intrinsic box is roughly
   2x its font-size. That box, not the padding, is what sets a row's height,
   so shrinking a container's padding alone does nothing. Worse, giving the
   container a fixed `height` smaller than the label makes the glyphs spill
   out and get cut by the nearest `overflow: hidden` ancestor.

   The rule that works:
     - single-line label  -> height: font-size + ~4px, plus
                             -unity-text-align: middle-*  (glyphs overflow the
                             smaller box harmlessly; only layout shrinks)
     - wrapping text (white-space: normal) -> never set a height
     - container holding text -> min-height, never height */

/* ============== Accent palettes (U-13) ==============
   Default (indigo) is defined above. A theme class on #app-root
   re-defines the accent family for the whole tree. Both the root
   itself and descendants need the override because the `*` block
   above defines the vars locally on every element. */

.theme-rose,
.theme-rose * {
    --accent: #EC4899;
    --accent-2: #F472B6;
    --accent-soft: rgba(236, 72, 153, 0.16);
    --accent-glow: rgba(236, 72, 153, 0.40);
    --accent-text: #F9C2DD;
}

.theme-cyan,
.theme-cyan * {
    --accent: #22D3EE;
    --accent-2: #67E8F9;
    --accent-soft: rgba(34, 211, 238, 0.16);
    --accent-glow: rgba(34, 211, 238, 0.40);
    --accent-text: #B9F1FB;
}

.theme-ember,
.theme-ember * {
    --accent: #F97316;
    --accent-2: #FBBF24;
    --accent-soft: rgba(249, 115, 22, 0.16);
    --accent-glow: rgba(249, 115, 22, 0.40);
    --accent-text: #FCD9B8;
}

.theme-mono,
.theme-mono * {
    --accent: #8A93A8;
    --accent-2: #AAB3C5;
    --accent-soft: rgba(138, 147, 168, 0.16);
    --accent-glow: rgba(138, 147, 168, 0.40);
    --accent-text: #D7DCE6;
}
