/* ============================================================
   ProvidersView — list + editor
   ============================================================ */

.providers-page {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px 20px 20px;
    overflow: hidden;
    position: relative;   /* якорь для оверлея-редактора */
}

.page__head {
    min-height: 34px;
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 14px;
}

.page__head-copy {
    flex-grow: 1;
    flex-direction: column;
}

.page__title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text-0);
    margin-bottom: 4px;
}

.page__subtitle {
    font-size: 13px;
    color: var(--text-3);
    white-space: normal;
}

.page__actions {
    flex-direction: row;
    align-items: center;
}

.page__actions > Button {
    margin-left: 8px;
}

/* ---- Split layout ---- */

.split {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.providers-list {
    flex-grow: 1;
    margin-right: 0;
}

/* ============== Provider row ============== */

.provider {
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 10px;
    margin-bottom: 6px;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.provider:hover {
    border-color: var(--line-2);
}

.provider--active {
    border-color: var(--accent);
    background-color: rgba(124, 122, 237, 0.10);
}

.provider--editing {
    border-color: var(--line-2);
    background-color: rgba(124, 122, 237, 0.05);
}

.provider--active.provider--editing {
    border-color: var(--accent);
    background-color: rgba(124, 122, 237, 0.14);
}

/* Colored logo for the active provider */
.provider--active .provider__logo {
    background-color: var(--accent);
    border-color: var(--accent);
}

.provider--active .provider__logo Label {
    color: rgb(255, 255, 255);
}

.provider--editing .provider__logo {
    border-color: var(--accent);
}

.provider__body {
    flex-grow: 1;
    flex-direction: column;
    margin-left: 10px;
    min-width: 0;
}

.provider__name-row {
    flex-direction: row;
    align-items: center;
}

.provider__name {
    font-size: 13px;
    height: 17px;
    -unity-text-align: middle-left;
    color: var(--text-0);
    -unity-font-style: bold;
    margin-right: 8px;
}

.provider__url {
    font-size: 10px;
    height: 14px;
    -unity-text-align: middle-left;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.provider__model {
    font-size: 10px;
    height: 14px;
    -unity-text-align: middle-left;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    margin-top: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.provider__meta {
    width: 70px;
    flex-direction: column;
    align-items: flex-end;
    margin-left: 12px;
}

.provider__meta-label {
    font-size: 9px;
    height: 12px;
    -unity-text-align: middle-right;
    color: var(--text-4);
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.provider__meta-value {
    font-size: 10px;
    height: 13px;
    -unity-text-align: middle-right;
    color: var(--text-2);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.provider__actions {
    flex-direction: row;
    margin-left: 12px;
    flex-shrink: 0;
}

.provider__actions > Button {
    margin-left: 6px;
    padding: 0 10px;
}

/* ============== Editor (right column) ============== */

/* Оверлей-подложка редактора провайдера (модалка по центру). */
.provider-edit-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

/* Карточка редактора — центрированный попап со своим вертикальным скроллом
   (.editor теперь ScrollView). Влезает при любом размере окна. */
.editor {
    width: 480px;
    max-width: 92%;
    max-height: 86%;
    flex-grow: 0;
    flex-shrink: 1;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 10px;
    padding: 14px;
    flex-direction: column;
}

.editor__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.editor__header-copy {
    flex-direction: column;
}

.editor__title {
    font-size: 14px;
    height: 19px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    color: var(--text-0);
    margin-bottom: 2px;
}

.editor__sub {
    font-size: 12px;
    height: 16px;
    -unity-text-align: middle-left;
    color: var(--text-3);
}

.editor__status {
    margin-top: 2px;
    font-size: 11px;
    height: 15px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.editor__status--active {
    color: var(--ok);
}

.editor__status--inactive {
    color: var(--text-3);
}

.editor__status--draft {
    color: var(--accent);
}

.field {
    flex-direction: column;
    margin-bottom: 8px;
}

.field__row {
    flex-direction: row;
    margin-bottom: 8px;
}

.field--half {
    flex-grow: 1;
    margin-bottom: 0;
    margin-right: 10px;
}

.slider-input {
    height: 28px;
}

/* ---- Slider numeric input (show-input-field) ---- */
.slider-input .unity-base-slider__text-field {
    min-width: 52px;
    max-width: 52px;
    margin-left: 8px;
}

.slider-input .unity-base-slider__text-field > .unity-text-field__input,
.slider-input .unity-base-slider__text-field > .unity-base-text-field__input {
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 8px;
    color: var(--text-1);
    font-size: 12px;
    height: 28px;
    padding: 0 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.slider-input .unity-base-slider__text-field > .unity-text-field__input:focus,
.slider-input .unity-base-slider__text-field > .unity-base-text-field__input:focus {
    border-color: var(--accent);
}

/* ---- Slider track/thumb ---- */
.slider-input .unity-base-slider__tracker {
    background-color: var(--bg-3);
    border-radius: 2px;
    border-width: 0;
    height: 4px;
}

.slider-input .unity-base-slider__dragger {
    background-color: var(--accent);
    border-width: 0;
    border-radius: 7px;
    width: 14px;
    height: 14px;
    margin-top: -5px;
}

/* ---- Test row ---- */

.testrow {
    min-height: 32px;
    flex-direction: row;
    align-items: flex-start;
    padding: 7px 10px;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 8px;
    background-color: var(--bg-2);
    margin-bottom: 10px;
}

.testrow--ok {
    color: var(--ok);
    border-color: rgba(77, 203, 133, 0.30);
    background-color: rgba(77, 203, 133, 0.06);
}

.testrow--error {
    color: var(--danger);
    border-color: rgba(239, 86, 86, 0.30);
    background-color: rgba(239, 86, 86, 0.06);
}

.testrow--error .testrow__icon {
    -unity-background-image-tint-color: var(--danger);
}

.testrow__icon {
    width: 14px;
    height: 14px;
    margin-right: 10px;
    margin-top: 2px;
    -unity-background-image-tint-color: var(--ok);
}

.testrow__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.provider-edit-actions {
    flex-direction: row;
}

.provider-edit-actions > Button {
    flex-grow: 1;
    margin-right: 8px;
}

/* ---- API key show/hide toggle (U-16) ---- */

.input-row {
    flex-direction: row;
    align-items: center;
}

.input-row > .input {
    flex-grow: 1;
}

.icon--eye {
    background-image: url("project://database/Assets/UI/Icons/eye.svg");
}

.icon--eye-off {
    background-image: url("project://database/Assets/UI/Icons/eye-off.svg");
}

/* ---- Global backend mode selector ---- */

.backend-selector {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin-bottom: 12px;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 14px;
}

.backend-selector > .label {
    font-size: 13px;
    color: var(--text-2);
    margin-right: 12px;
    flex-shrink: 0;
}

.backend-selector > .input {
    width: 220px;
}

.backend-selector__hint {
    font-size: 11px;
    color: var(--text-3);
    margin-left: 12px;
    white-space: normal;
}

.provider-context-hint {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 5px;
    white-space: normal;
}

.provider-context-hint--error {
    color: var(--danger);
}

/* ============================================================
   Узкое окно: компактнее паддинги и плотнее строки провайдеров.
   meta «Источник» прячем — освобождаем место под имя/URL/действия,
   чтобы содержимое строки не налезало.
   ============================================================ */
.app--compact .providers-page {
    padding: 12px 14px 14px;
}

.app--compact .provider {
    padding: 7px 10px;
}

.app--compact .provider__meta {
    display: none;
}

/* ============================================================
   Phone — stack the backend selector so its fixed 220px dropdown
   doesn't push the row off-screen (horizontal scroll).
   ============================================================ */
.ff-phone .backend-selector {
    flex-direction: column;
    align-items: stretch;
}

.ff-phone .backend-selector > .label {
    margin-right: 0;
    margin-bottom: 8px;
}

.ff-phone .backend-selector > .input {
    width: 100%;
}

.ff-phone .backend-selector__hint {
    margin-left: 0;
    margin-top: 6px;
}

/* Provider edit action buttons wrap instead of overflowing. */
.ff-phone .provider-edit-actions {
    flex-wrap: wrap;
}
