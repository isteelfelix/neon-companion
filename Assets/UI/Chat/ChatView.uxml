<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="../Theme/Tokens.uss" />
    <ui:Style src="../Theme/Components.uss" />
    <ui:Style src="ChatView.uss" />
    <ui:Style src="../Main/MainView.Tints.uss" />
    <ui:Style src="../Terminal/TerminalView.uss" />

    <ui:VisualElement name="chat-stage" class="stage">

        <!-- CENTER: Messages + composer -->
        <ui:VisualElement class="chat-main">
            <ui:ScrollView name="messages-list" class="transcript" />

            <ui:VisualElement name="composer" class="composer">
                <ui:VisualElement name="composer-previews" class="composer__previews" style="display: none;" />
                <ui:VisualElement name="composer-controls" class="composer__controls">
                    <ui:Button name="attach-btn" class="iconbtn icon icon--attach" tooltip="Добавить вложение" />
                    <ui:Button name="mic-button" class="iconbtn icon icon--mic mic-btn" tooltip="Голосовой ввод" />
                    <ui:TextField name="message-input" class="composer__input" placeholder="Введите сообщение..." multiline="true" />
                    <ui:VisualElement class="composer__hint">
                        <ui:Label text="⌘" class="kbd" />
                        <ui:Label text="↵" class="kbd" />
                    </ui:VisualElement>
                    <ui:Button name="send-button" text="Отправить" class="btn btn--primary composer__send" />
                    <ui:Button name="stop-button" text="■" class="iconbtn" tooltip="Остановить генерацию" style="display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Scroll-to-bottom: last child so it paints on top of composer -->
            <ui:Button name="scroll-bottom-btn" text="↓" class="scroll-bottom-btn" />
        </ui:VisualElement>

        <!-- Drag-to-resize handle -->
        <ui:VisualElement name="resize-handle" class="resize-handle" />

        <!-- RIGHT: Avatar panel -->
        <ui:VisualElement name="avatar-panel" class="avatar-panel">

            <ui:VisualElement name="thinking-bubble" class="thinking-bubble" style="display: none;">
                <ui:Label name="thinking-text" class="thinking-bubble__text" />
            </ui:VisualElement>

            <ui:VisualElement name="avatar-stage-hero" class="avatar-stage__hero">
                <ui:VisualElement name="avatar-glow" class="halo" />
                <ui:VisualElement name="avatar-circle" class="avatar">
                    <ui:VisualElement name="avatar-art" class="avatar__art avatar__art--neon" />
                    <ui:VisualElement class="avatar__shade" />
                    <ui:Label text="N" class="avatar__letter" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
