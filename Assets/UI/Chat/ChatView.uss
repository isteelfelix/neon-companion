/* ============================================================
   ChatView — sessions left | chat center | avatar right
   ============================================================ */

.stage {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* ============== LEFT: Sessions history ============== */

.history {
    width: 260px;
    flex-shrink: 0;
    background-color: var(--bg-1);
    border-right-width: 1px;
    border-right-color: var(--line-1);
    flex-direction: column;
}

.history__head {
    height: 57px;
    padding: 14px 16px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
}

.history__title-label {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-0);
}

.history__actions {
    flex-direction: row;
}

.history__actions > Button {
    margin-left: 4px;
}

.history__list {
    flex-grow: 1;
    padding: 8px;
}

.history__searchbar {
    flex-direction: row;
    align-items: center;
    margin: 0 8px 6px;
    padding: 4px 8px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
}

.history__searchbar-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 6px;
}

.history__searchbar-input {
    flex-grow: 1;
    height: 28px;
}

.history__searchbar-input > .unity-text-field__input,
.history__searchbar-input > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--text-0);
    font-size: 12px;
    padding: 0 2px;
}

.history__searchbar-clear {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    padding: 4px;
    flex-shrink: 0;
}

.history__group {
    font-size: 10px;
    color: var(--text-4);
    letter-spacing: 1px;
    padding: 14px 12px 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* Folder grouping headers (H-04) */
.session-folder-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin-top: 6px;
    margin-bottom: 2px;
    background-color: var(--bg-2);
    border-radius: 6px;
}

.session-folder-header:hover {
    background-color: var(--bg-3);
}

.session-folder-chevron {
    font-size: 10px;
    color: var(--text-3);
    width: 14px;
    margin-right: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.session-folder-name {
    font-size: 11px;
    color: var(--text-2);
    -unity-font-style: bold;
    flex-grow: 1;
}

/* Session folder context menu and input popup (reuses some message-context-menu item styles) */
.session-context-menu {
    flex-direction: column;
    background-color: var(--bg-4);
    border-width: 1px;
    border-color: var(--line-3);
    border-radius: 8px;
    padding: 4px;
    position: absolute;
    min-width: 160px;
}

.folder-name-input-popup {
    flex-direction: column;
    background-color: var(--bg-4);
    border-width: 1px;
    border-color: var(--line-3);
    border-radius: 8px;
    padding: 10px;
    position: absolute;
    min-width: 180px;
}

.folder-name-input-popup__title {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 6px;
}

.folder-name-input-popup__input {
    background-color: var(--bg-2);
    color: var(--text-0);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-size: 13px;
}

.folder-name-input-popup__input > .unity-text-field__input,
.folder-name-input-popup__input > .unity-base-text-field__input {
    background-color: var(--bg-2);
    color: var(--text-0);
    border-width: 0;
    padding: 0;
}

.history__item {
    padding: 10px 12px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    margin-bottom: 2px;
}

.history__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.history__item:hover {
    background-color: var(--bg-2);
}

.history__item--active {
    background-color: var(--bg-3);
    border-color: var(--line-2);
}

.history__title {
    font-size: 13px;
    color: var(--text-1);
    flex-grow: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.history__provider {
    font-size: 10px;
    color: var(--accent-2);
    background-color: var(--accent-soft);
    border-radius: 6px;
    padding: 2px 8px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.history__meta {
    font-size: 10px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ============== CENTER: Chat main ============== */

.chat-main {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    padding: 18px 28px 22px;
    position: relative;
}

/* Drag-and-drop overlay */
.chat-main--drag-over {
    background-color: rgba(100, 120, 237, 0.08);
    border-width: 2px;
    border-color: rgba(100, 120, 237, 0.4);
    border-radius: 12px;
}

.scroll-bottom-btn {
    position: absolute;
    bottom: 100px;
    right: -6px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0.6);
    color: white;
    font-size: 18px;
    display: none;
    justify-content: center;
    align-items: center;
}

.scroll-bottom-btn:hover {
    background-color: rgba(0, 0, 0, 0.8);
}

/* ---- Transcript ---- */

.transcript {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 14px;
    /* Negative right margin cancels chat-main's 28px right padding for the transcript only,
       so the vertical scrollbar sits in the empty band against the avatar panel (Claude-style).
       Composer / context bar keep their inset; message content is restored via row padding below. */
    margin-right: -28px;
    padding: 2px 8px 2px 0;
}

.transcript > .unity-scroller--horizontal {
    display: none;
}

.transcript__empty {
    min-height: 108px;
    justify-content: center;
    padding: 18px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
}

.transcript__empty-title {
    color: var(--text-0);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.transcript__empty-body {
    color: var(--text-3);
    font-size: 12px;
    white-space: normal;
}

.transcript__empty-action {
    align-self: flex-start;
    margin-top: 14px;
}

.transcript__row {
    flex-direction: row;
    margin-bottom: 10px;
    /* Keep message content off the relocated scrollbar (restores the inset removed above). */
    padding-right: 16px;
}

.transcript__row--user      { justify-content: flex-end; }
.transcript__row--assistant,
.transcript__row--system    { justify-content: flex-start; }
.transcript__row--assistant { align-items: flex-end; }

.transcript__bubble {
    position: relative;
    width: 72%;
    max-width: 86%;
    min-width: 120px;
    flex-shrink: 0;
    padding: 10px 12px;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    background-color: var(--bg-2);
}

.transcript__bubble--markdown {
    width: 86%;
    max-width: 92%;
    min-width: 340px;
    padding: 12px 13px 10px 13px;
}

.transcript__bubble--user {
    width: auto;
    max-width: 78%;
    min-width: 0;
    background-color: var(--accent-soft);
    border-color: rgba(124, 122, 237, 0.38);
}

.transcript__bubble--user.transcript__bubble--markdown {
    width: 86%;
    max-width: 92%;
}

.transcript__bubble--system {
    border-color: rgba(239, 171, 86, 0.30);
    background-color: rgba(239, 171, 86, 0.08);
}

/* ---- Bubble hover actions (copy/refresh/listen) ---- */

.transcript__bubble-actions {
    position: absolute;
    left: 100%;
    top: 0;
    flex-direction: column;
    padding-left: 4px;
    flex-shrink: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
}

/* Reveal only when hovering the bubble itself (or the buttons), not the empty
   space beside the bubble. padding-left bridges the gap so moving onto the
   buttons keeps them visible. */
.transcript__bubble--assistant:hover > .transcript__bubble-actions,
.transcript__bubble-actions:hover {
    opacity: 1;
    visibility: visible;
}

.transcript__bubble-actions--busy {
    opacity: 1;
    visibility: visible;
}

.transcript__bubble-actions > Button {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin: 1px 0;
    padding: 3px;
    font-size: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    color: var(--text-2);
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}

.transcript__bubble-actions > Button:hover {
    background-color: rgba(0, 0, 0, 0.8);
    color: var(--text-0);
    -unity-background-image-tint-color: var(--text-0);
}

.transcript__bubble-actions > .voice-output-button--busy {
    background-color: var(--accent);
    color: rgb(255, 255, 255);
    font-size: 9px;
    -unity-text-align: middle-center;
    padding: 0;
}

.transcript__meta {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.transcript__role {
    flex-grow: 1;
    color: var(--text-2);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
}

.transcript__time {
    color: var(--text-3);
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.transcript__body {
    color: var(--text-0);
    font-size: 13px;
    white-space: normal;
}

.transcript__body--user {
    white-space: pre-wrap;
}

/* TextField used in place of Label so text is user-selectable (U-34).
   Strip all visual chrome so it looks identical to a plain label. */
.transcript__body > .unity-text-field__input,
.transcript__body > .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    color: var(--text-0);
    font-size: 13px;
    white-space: normal;
}

.transcript__body--user > .unity-text-field__input,
.transcript__body--user > .unity-base-text-field__input {
    white-space: pre-wrap;
    color: var(--text-1);
}

/* ---- Streaming stats footer (tokens + elapsed time, inside assistant bubble) ---- */

.transcript__stats {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.transcript__stats-label {
    font-size: 10px;
    color: var(--text-3);
    margin-right: 2px;
}

/* ---- Subtitle (last AI message) ---- */

.subtitle {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    min-width: 0;
    background-color: var(--bg-2);
    border-width: 1px;
    border-left-width: 2px;
    border-color: var(--line-2);
    border-left-color: var(--accent);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 14px;
}

.subtitle__role {
    flex-shrink: 0;
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
    margin-right: 12px;
}

.subtitle__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    color: var(--text-0);
    font-size: 14px;
    white-space: normal;
}

.subtitle__actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: auto;
    justify-content: flex-end;
    margin-top: 4px;
}

.subtitle__actions > Button {
    margin-left: 4px;
}

.typing {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 24px;
}

.typing__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--accent);
    margin-right: 4px;
}

.typing__dot--delay-1 { background-color: var(--accent-2); }
.typing__dot--delay-2 { background-color: var(--accent-text); }

/* ---- Composer ---- */

.composer {
    min-height: 54px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 14px;
    padding: 8px 8px 8px 14px;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.composer__controls {
    flex-direction: row;
    align-items: flex-end;
    min-height: 36px;
}

.mic-btn--recording {
    color: rgb(255, 255, 255);
    border-color: rgb(255, 84, 84);
    background-color: rgb(220, 48, 48);
    scale: 1.1 1.1;
}

.mic-btn--audio-attached {
    opacity: 0.45;
    background-color: rgba(124, 122, 237, 0.12);
    border-color: rgba(124, 122, 237, 0.35);
    -unity-background-image-tint-color: var(--accent-text);
}

.composer--focused {
    border-color: var(--accent);
}

/* ScrollView wrapper around the composer input: owns the row layout + 140px cap and shows a
   vertical scrollbar when the draft overflows. The TextField itself sizes to its content inside. */
.composer__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 36px;
    max-height: 140px;
    margin-left: 8px;
    margin-right: 10px;
    margin-bottom: 0;
}

.composer__input {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    min-height: 36px;
    width: 100%;
}

.composer__input > .unity-text-field__input,
.composer__input > .unity-base-text-field__input {
    min-height: 36px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--text-0);
    font-size: 14px;
    padding: 4px 4px;
    white-space: normal;
}

/* Slim the ScrollView's vertical scrollbar to fit the neon composer. */
.composer__scroll .unity-scroller--vertical {
    width: 8px;
}

.composer__scroll #unity-content-and-vertical-scroll-container {
    flex-grow: 1;
}

.composer__hint {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 8px;
    margin-bottom: 7px;
}

.composer__hint > Label {
    margin-left: 4px;
}

.composer__send {
    height: 36px;
    flex-shrink: 0;
    margin-bottom: 0;
}

/* Composer image preview strip */
.composer__previews {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 0 8px 0;
    flex-shrink: 0;
}

.composer__preview-thumb {
    position: relative;
    width: 80px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255,255,255,0.12);
    background-color: rgba(0,0,0,0.25);
    margin-right: 6px;
    margin-bottom: 4px;
}

/* Image fills the entire thumb — positioned absolute so remove button overlays on top */
.composer__preview-img {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.composer__preview-file {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    bottom: 8px;
    color: var(--text-1);
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Hover hint on thumb */
.composer__preview-thumb:hover {
    border-color: rgba(255, 255, 255, 0.35);
}

/* × button overlaid in top-right corner */
.composer__preview-remove {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    padding: 0;
    border-radius: 9px;
    border-width: 0;
    background-color: rgba(0,0,0,0.65);
    color: #fff;
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* ============== RIGHT: Avatar panel ============== */

.avatar-panel {
    width: 260px;
    flex-shrink: 0;
    flex-direction: column;
    border-left-width: 1px;
    border-left-color: var(--line-1);
    position: relative;
    overflow: hidden;
}

/* ---- Avatar panel header ---- */

.avatar-panel__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
}

/* ---- Status badge ---- */

.statusrow {
    flex-direction: row;
    align-items: center;
    background-color: rgba(11, 12, 16, 0.70);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 5px 10px 5px 7px;
}

.statusrow__dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background-color: var(--ok);
    margin-right: 8px;
}

.statusrow__text {
    font-size: 11px;
    color: var(--text-2);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ---- Provider tag ---- */

.providertag {
    flex-direction: row;
    align-items: center;
    background-color: rgba(11, 12, 16, 0.70);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 7px 12px;
    margin: 0;
    transition-property: border-color;
    transition-duration: 0.12s;
}

.providertag:hover {
    border-color: var(--line-3);
}

.provider__logo {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    align-items: center;
    justify-content: center;
}

.provider__logo Label {
    color: var(--text-1);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
}

.provider__logo--mini {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    margin-right: 8px;
}

.provider__logo--mini Label {
    font-size: 9px;
}

.provider__logo--editor {
    width: 44px;
    height: 44px;
    margin-right: 12px;
}

.providertag__body {
    flex-direction: column;
    margin-right: 8px;
}

.providertag__name {
    font-size: 12px;
    color: var(--text-1);
    -unity-font-style: bold;
}

.providertag__model {
    font-size: 11px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.providertag__arrow {
    width: 14px;
    height: 14px;
}

/* ---- Avatar hero ---- */

.avatar-stage__hero {
    flex-grow: 1;
    min-height: 0;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 24px;
}

.halo {
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 999px;
    background-color: rgba(124, 122, 237, 0.16);
    opacity: 0.6;
}

.avatar {
    width: 240px;
    height: 240px;
    border-radius: 999px;
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.avatar--square { border-radius: 20px; }
.avatar--hex    { border-radius: 38px; }

.avatar__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.avatar__art--neon { background-color: #4f45d8; }

.avatar__shade {
    position: absolute;
    left: 36px;
    top: 36px;
    width: 168px;
    height: 168px;
    border-radius: 999px;
    background-color: rgba(11, 12, 16, 0.18);
}

.avatar__letter {
    color: rgba(255, 255, 255, 0.88);
    font-size: 56px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
}

.avatar-emoji-overlay {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.avatar-frame--none { }
.avatar-frame--neon { border-width: 2px; }
.avatar-frame--gold { border-width: 3px; border-color: #f4c34f; }
.avatar-frame--holographic { border-width: 3px; border-color: #7ce7ff; }

/* Session delete button */
.history__delete-btn {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    padding: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: var(--text-3);
    font-size: 13px;
    display: none;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.history__item:hover .history__delete-btn {
    display: flex;
}

.history__delete-btn:hover,
.history__delete-btn--confirm {
    background-color: rgba(239, 100, 100, 0.15);
    border-color: rgba(239, 100, 100, 0.30);
    color: #ef6464;
}

/* ---- Inline typing dots (inside streaming bubble) ---- */

.typing--inline {
    flex-direction: row;
    padding: 8px 12px;
}

.typing--inline .typing__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    margin-right: 4px;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.typing--inline .typing__dot--delay-1 {
    opacity: 0.3;
}

.typing--inline .typing__dot--delay-2 {
    opacity: 0.15;
}

/* ============== Thinking bubble (above avatar) ============== */

.thinking-bubble {
    margin: 10px 12px 0;
    padding: 8px 12px;
    background-color: rgba(124, 122, 237, 0.10);
    border-width: 1px;
    border-color: rgba(124, 122, 237, 0.35);
    border-radius: 12px;
    border-top-left-radius: 4px;
    flex-direction: column;
    align-items: flex-start;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.thinking-bubble__text {
    color: rgba(124, 122, 237, 0.85);
    font-size: 11px;
    -unity-font-style: italic;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ============== Tool call entries (in transcript) ============== */

.tool-entry {
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    border-left-width: 2px;
    border-left-color: var(--line-3);
    border-radius: 6px;
    padding: 5px 9px;
    margin-bottom: 4px;
    min-height: 26px;
    transition-property: background-color, border-left-color;
    transition-duration: 0.15s;
}

.tool-entry:hover {
    background-color: var(--bg-4);
}

/* Status accent stripe on the left edge */
.tool-entry--running {
    border-left-color: var(--accent);
}

.tool-entry--done {
    border-left-color: var(--ok);
}

.tool-entry--reasoning {
    border-left-color: var(--accent);
}

.tool-entry__icon {
    font-size: 13px;
    flex-shrink: 0;
    margin-right: 6px;
    width: 18px;
    -unity-text-align: middle-center;
}

.tool-entry__name {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-1);
    margin-right: 8px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
}

.tool-entry__label {
    font-size: 11px;
    color: var(--text-2);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.tool-entry__status {
    font-size: 11px;
    flex-shrink: 0;
    margin-left: 6px;
    width: 14px;
    -unity-text-align: middle-center;
}

.tool-entry__status--running {
    color: var(--accent);
    transition-property: opacity;
    transition-duration: 0.6s;
}

.tool-entry__status--failed {
    color: rgb(255, 84, 84);
}

.tool-entry__status--done {
    color: var(--ok);
}

.tool-entry-root {
    margin-bottom: 4px;
}

.tool-entry__toggle {
    font-size: 10px;
    flex-shrink: 0;
    margin-right: 4px;
    width: 12px;
    -unity-text-align: middle-center;
    color: var(--text-4);
}

.tool-entry__details {
    flex-direction: column;
    padding: 4px 8px 4px 32px;
    margin-bottom: 4px;
}

.tool-entry__args {
    font-size: 11px;
    color: var(--text-3);
    white-space: pre-wrap;
}

/* ---- Reasoning / thinking (variant B: dark surface, accent stripe, muted) ---- */

.reasoning-entry__details {
    flex-direction: column;
    background-color: var(--bg-1);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-radius: 6px;
    margin-left: 24px;
    margin-bottom: 4px;
    padding: 8px 12px 8px 12px;
}

.reasoning-entry__text {
    font-size: 12px;
    color: var(--text-2);
    -unity-font-style: italic;
    white-space: normal;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

/* Strip the default TextField chrome so the readonly reasoning text reads as a note,
   not an input box (this was rendering as a jarring light panel on the dark theme). */
.reasoning-entry__text > .unity-text-field__input,
.reasoning-entry__text > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    color: var(--text-2);
    font-size: 12px;
    -unity-font-style: italic;
    white-space: normal;
}

.tool-entry__diff {
    flex-direction: column;
}

.tool-entry__diff-line {
    font-size: 11px;
    white-space: pre;
    color: var(--text-3);
}

.tool-entry__diff-line--add {
    color: #4ade80;
}

.tool-entry__diff-line--del {
    color: #f87171;
}

.tool-entry__diff-line--hunk {
    color: #60a5fa;
}

/* ---- Markdown rendering (assistant messages) ---- */

.markdown-root {
    flex-direction: column;
}

.markdown-paragraph {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.markdown-bold {
    -unity-font-style: bold;
}

.markdown-italic {
    -unity-font-style: italic;
}

.markdown-code {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 11px;
    color: var(--accent-text);
    background-color: var(--accent-soft);
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.markdown-codeblock {
    flex-direction: column;
    background-color: var(--bg-0);
    border-width: 1px;
    border-color: var(--line-1);
    padding: 8px 12px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    overflow: hidden;
}

.markdown-codeblock-text {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 10px;
    white-space: pre;
    color: var(--text-1);
    --unity-text-selection-color: rgba(124, 122, 237, 0.35);
}

.markdown-bullet {
    flex-direction: row;
    margin-left: 16px;
    margin-bottom: 2px;
}

.markdown-bullet-marker {
    margin-right: 6px;
    color: var(--accent-2);
}

.markdown-numbered {
    flex-direction: row;
    margin-left: 16px;
    margin-bottom: 2px;
}

.markdown-numbered-marker {
    margin-right: 6px;
    color: var(--accent-2);
    min-width: 20px;
}

.markdown-link {
    color: var(--accent-text);
}

.markdown-strike {
    color: var(--text-3);
}

.markdown-blockquote {
    flex-direction: row;
    flex-wrap: wrap;
    border-left-width: 3px;
    border-left-color: var(--accent);
    padding-left: 10px;
    margin-top: 2px;
    margin-bottom: 2px;
    color: var(--text-2);
}

.markdown-hr {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 8px;
    margin-bottom: 8px;
}

.markdown-table {
    flex-direction: column;
    margin-top: 4px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.markdown-table-row {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.markdown-table-row--last {
    border-bottom-width: 0px;
}

.markdown-table-row--header {
    background-color: rgba(255, 255, 255, 0.06);
}

.markdown-table-row--alt {
    background-color: rgba(255, 255, 255, 0.025);
}

.markdown-table-cell {
    flex-grow: 1;
    flex-basis: 0px;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    min-width: 0;
}

.markdown-table-cell--last {
    border-right-width: 0px;
}

.markdown-table-cell--header {
    -unity-font-style: bold;
}

.markdown-h1 {
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 6px;
    white-space: normal;
}

.markdown-h2 {
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 4px;
    white-space: normal;
}

.markdown-h3 {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 2px;
    white-space: normal;
}

.markdown-h4 {
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 2px;
    white-space: normal;
}

.markdown-h5 {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.markdown-h6 {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-2);
    white-space: normal;
}

/* ---- Approval prompt (agent tool call approval) ---- */

.approval-prompt {
    flex-direction: column;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-left-width: 2px;
    border-left-color: var(--warn);
    border-radius: 10px;
    padding: 12px 14px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.approval-prompt__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.approval-prompt__icon {
    font-size: 15px;
    margin-right: 8px;
    color: var(--warn);
}

.approval-prompt__tool-name {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--text-0);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
}

.approval-prompt__description {
    font-size: 12px;
    color: var(--text-2);
    margin-bottom: 8px;
    white-space: pre-wrap;
}

.approval-prompt__params {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 11px;
    color: var(--text-3);
    background-color: var(--bg-0);
    border-width: 1px;
    border-color: var(--line-1);
    padding: 6px 8px;
    border-radius: 6px;
    margin-bottom: 10px;
    white-space: pre-wrap;
}

.approval-prompt__buttons {
    flex-direction: row;
}

.approval-prompt__btn {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-right: 8px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 12px;
    -unity-font-style: bold;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.approval-prompt__btn--approve {
    background-color: var(--ok-soft);
    border-color: var(--ok);
    color: var(--ok);
}

.approval-prompt__btn--approve:hover {
    background-color: var(--ok);
    color: var(--bg-0);
}

.approval-prompt__btn--reject {
    background-color: rgba(226, 112, 71, 0.14);
    border-color: var(--danger);
    color: var(--danger);
}

.approval-prompt__btn--reject:hover {
    background-color: var(--danger);
    color: var(--bg-0);
}

.approval-prompt__btn--always {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-text);
}

.approval-prompt__btn--always:hover {
    background-color: var(--accent);
    color: #ffffff;
}

/* ---- Message context menu (U-29/U-30) ---- */

.message-context-menu {
    flex-direction: column;
    background-color: var(--bg-4);
    border-width: 1px;
    border-color: var(--line-3);
    border-radius: 8px;
    padding: 4px;
    position: absolute;
    min-width: 150px;
    min-height: 32px;
}

.message-context-menu__item {
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 4px;
    min-height: 28px;
}

.message-context-menu__item:hover,
.message-context-menu__item--hover {
    background-color: var(--accent-soft);
}

.message-context-menu__icon {
    margin-right: 8px;
    font-size: 14px;
    width: 18px;
}

.message-context-menu__label {
    font-size: 13px;
    color: var(--text-1);
}

/* ---- Inline message edit (U-29) ---- */

.message-edit-container {
    flex-direction: column;
    margin-top: 4px;
    margin-bottom: 2px;
}

.message-edit-field {
    background-color: var(--bg-1);
    color: var(--text-0);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 13px;
    min-height: 60px;
}

.message-edit-field > .unity-text-field__input,
.message-edit-field > .unity-base-text-field__input {
    background-color: transparent;
    color: var(--text-0);
    padding: 0;
}

.message-edit-buttons {
    flex-direction: row;
    margin-top: 6px;
    align-items: center;
}

.message-edit-btn {
    margin-right: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: var(--bg-4);
    color: var(--text-1);
    border-width: 1px;
    border-color: var(--line-2);
    min-width: 60px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.message-edit-btn--save {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-text);
}

.message-edit-btn--save:hover {
    background-color: var(--accent);
    color: #ffffff;
}

.message-edit-btn--regen {
    background-color: var(--ok-soft);
    border-color: var(--ok);
    color: var(--ok);
}

.message-edit-btn--regen:hover {
    background-color: var(--ok);
    color: var(--bg-0);
}

.message-edit-btn--cancel:hover {
    background-color: var(--bg-3);
    border-color: var(--line-3);
}

/* ============== Chat Search Bar (U-38) ============== */

.search-bar {
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-1);
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    margin-bottom: 2px;
    flex-shrink: 0;
}

.search-bar__input {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 6px;
    min-width: 120px;
}

.search-bar__input > .unity-text-field__input,
.search-bar__input > .unity-base-text-field__input {
    border-width: 0;
    background-color: transparent;
    color: var(--text-1);
    font-size: 12px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.search-bar__count {
    font-size: 11px;
    color: var(--text-3);
    margin-right: 6px;
    min-width: 32px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* Highlighted rows during search (U-38) */
.transcript__row--search-match {
    background-color: rgba(255, 200, 0, 0.08);
    border-radius: 6px;
}

.transcript__row--search-current {
    background-color: rgba(255, 200, 0, 0.18);
    border-radius: 6px;
}

/* ============== Inline Attachments & Images (U-41) ============== */

.transcript__attachments {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.transcript__image {
    max-width: 300px;
    max-height: 200px;
    border-radius: 6px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: var(--line-2);
    transition-property: opacity, border-color;
    transition-duration: 0.15s;
}

.transcript__image:hover {
    border-color: rgba(255, 255, 255, 0.42);
    opacity: 0.88;
}

/* Context window indicator */
.context-bar {
    position: relative;
    height: 18px;
    flex-shrink: 0;
    margin-top: 4px;
    overflow: hidden;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
}

.context-bar__fill {
    height: 100%;
    width: 0%;
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.3s;
}

.context-bar__label {
    position: absolute;
    left: 8px;
    top: 0;
    height: 18px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-left;
}

/* Message queue indicator */
.queue-indicator {
    height: 20px;
    flex-shrink: 0;
    padding-left: 12px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-left;
}

/* Selection mode (U-31/U-32) */
.transcript__row--selected .transcript__bubble {
    border-width: 2px;
    border-color: var(--accent);
}

.selection-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 48px;
    flex-shrink: 0;
    background-color: var(--bg-3);
    border-top-width: 2px;
    border-top-color: var(--accent);
}

.selection-bar__count {
    font-size: 13px;
    color: var(--text-1);
    margin-right: 8px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.selection-bar__btn {
    height: 32px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: var(--bg-4);
    color: var(--text-1);
    font-size: 13px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.selection-bar__btn:hover {
    background-color: var(--bg-3);
    border-color: var(--line-3);
}

.selection-bar__btn--danger {
    background-color: rgba(226, 112, 71, 0.14);
    border-color: var(--danger);
    color: var(--danger);
}

.selection-bar__btn--danger:hover {
    background-color: var(--danger);
    border-color: var(--danger);
    color: var(--bg-0);
}

/* Children spacing (gap not supported in USS; use margin) */
.selection-bar > * {
    margin-left: 6px;
    margin-right: 6px;
}

/* Notification badge */
.nav__count--notify {
    background-color: rgba(220, 50, 50, 0.9);
    color: #fff;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    font-size: 11px;
    -unity-text-align: middle-center;
    padding-left: 4px;
    padding-right: 4px;
}

/* Session forward picker overlay (U-33) — centered modal, reuses dark panel style */
.session-picker-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.session-picker {
    flex-direction: column;
    background-color: var(--bg-4);
    border-width: 1px;
    border-color: var(--line-3);
    border-radius: 10px;
    min-width: 260px;
    max-width: 340px;
    max-height: 380px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.session-picker__header {
    font-size: 13px;
    color: var(--text-3);
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 8px;
}

.session-picker__list {
    flex-grow: 1;
    min-height: 60px;
}

.session-picker__item {
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.session-picker__item:hover,
.session-picker__item--hover {
    background-color: var(--accent-soft);
}

.session-picker__title {
    flex-grow: 1;
    font-size: 13px;
    color: var(--text-1);
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: start;
}

.session-picker__time {
    font-size: 11px;
    color: var(--text-3);
    margin-left: 8px;
    flex-shrink: 0;
}

.session-picker__footer {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
}


/* ============================================================
   Phone (ff-phone) — chat reflows to a single column
   Form-factor class is set in C# (LayoutController) on #app-root.
   ============================================================ */

/* Avatar panel becomes a full-screen overlay instead of a 3rd column.
   Toggled via avatar--open (C#); paints on top via BringToFront(). */
.ff-phone .avatar-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: auto;
    border-left-width: 0;
    background-color: var(--bg-0);
    display: none;
}

.ff-phone .avatar-panel.avatar--open {
    display: flex;
}

/* Terminal isn't useful on a phone — hide the Avatar/Terminal tab bar so the
   avatar overlay just shows the avatar. (#right-panel-tabs is built in C#.) */
.ff-phone #right-panel-tabs {
    display: none;
}

/* Roomier composer + larger input text for touch. padding-bottom is left to
   the base/.platform-android rule so it can absorb the gesture-nav inset. */
.ff-phone .composer {
    padding-top: 6px;
    padding-left: 8px;
    padding-right: 6px;
}

.ff-phone .composer__input {
    font-size: 15px;
    min-height: 40px;
}

/* The ⌘/↵ keyboard hint is meaningless on touch — reclaim that width. */
.ff-phone .composer__hint {
    display: none;
}

/* Shrink the left attach/mic buttons so the text input gets the room.
   More specific than the generic ff-phone .iconbtn 44px rule, so it wins. */
.ff-phone .composer__controls .iconbtn {
    min-width: 38px;
    min-height: 38px;
    width: 38px;
    height: 38px;
    padding: 8px;
}

/* "Отправить" → compact arrow button: hide the label (transparent text) and
   paint the send glyph as a centered background image. Keeps btn--primary bg. */
.ff-phone .composer__send {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    padding-left: 0;
    padding-right: 0;
    color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Icons/send.svg");
    -unity-background-image-tint-color: #ffffff;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
    background-size: 18px 18px;
}

/* Bubbles use more of the narrow width. */
.ff-phone .transcript__bubble {
    max-width: 88%;
}

/* Bubble actions (copy / regenerate / listen): on desktop they float at left:100%
   and reveal on hover. Touch has no hover and that off-bubble strip is unreachable,
   so on phone drop them into the flow under the bubble, always visible, big enough
   to tap. */
.ff-phone .transcript__bubble-actions {
    position: relative;
    left: auto;
    top: auto;
    flex-direction: row;
    padding-left: 0;
    margin-top: 8px;
    opacity: 1;
    visibility: visible;
}

.ff-phone .transcript__bubble-actions > Button {
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
    padding: 8px;
    margin-right: 8px;
    margin-top: 0;
    margin-bottom: 0;
}

/* ============== Image Lightbox (click-to-preview) ============== */

.lightbox {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.87);
    align-items: center;
    justify-content: center;
}

/* Image is sized to 80% of lightbox; ScaleToFit in C# keeps aspect ratio */
.lightbox__image {
    width: 80%;
    height: 80%;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.lightbox__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 20px;
    -unity-text-align: middle-center;
    padding: 0;
}

.lightbox__close:hover {
    background-color: rgba(255, 255, 255, 0.28);
}

/* ---- Hermes Clarify Choice Buttons ---- */

.clarify-choices {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-left: 40px;
}

.clarify-choices__btn {
    padding: 8px 14px;
    margin: 3px 4px;
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 10px;
    background-color: var(--accent-soft);
    color: var(--accent-text);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.clarify-choices__btn:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
}

.clarify-choices__btn:disabled {
    border-color: var(--line-2);
    background-color: var(--bg-2);
    color: var(--text-3);
    opacity: 0.6;
}

/* ============================================================
   Voice preview bar (composer, shown after recording stops)
   ============================================================ */

.voice-preview {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 44px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(124, 122, 237, 0.10);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(124, 122, 237, 0.30);
    margin-bottom: 6px;
}

.voice-preview__play {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 14px;
    background-color: var(--accent);
    border-width: 0;
    color: #fff;
    font-size: 11px;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-right: 8px;
    flex-shrink: 0;
}

.voice-preview__mic-icon {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    -unity-background-image-tint-color: var(--text-2);
    margin-right: 4px;
    flex-shrink: 0;
}

.voice-preview__duration {
    font-size: 12px;
    color: var(--text-2);
    min-width: 32px;
    margin-right: 10px;
    flex-shrink: 0;
}

.voice-preview__text {
    font-size: 12px;
    color: var(--text-1);
    flex-shrink: 1;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.voice-preview__text--loading {
    color: var(--accent);
}

.voice-preview__text--error {
    color: rgb(239, 171, 86);
}

.voice-preview__cancel {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    border-radius: 12px;
    background-color: transparent;
    border-width: 0;
    color: var(--text-3);
    font-size: 12px;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 6px;
    flex-shrink: 0;
}

.voice-preview__cancel:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--text-0);
}

.voice-preview__send {
    flex-shrink: 0;
    margin-left: 6px;
    height: 28px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 12px;
}

/* ============================================================
   Voice bubble — appears inside user message bubbles
   ============================================================ */

.voice-bubble {
    flex-direction: row;
    align-items: center;
    min-width: 220px;
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(124, 122, 237, 0.20);
}

.voice-bubble--playing {
    border-top-color: var(--accent);
}

.voice-bubble__play {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    border-radius: 12px;
    background-color: var(--accent);
    border-width: 0;
    color: #fff;
    font-size: 10px;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-right: 6px;
    flex-shrink: 0;
}

.voice-bubble--paused .voice-bubble__play {
    background-color: var(--accent-2);
}

.voice-bubble__timeline {
    flex-grow: 1;
    min-width: 150px;
    flex-direction: column;
}

.voice-bubble__track {
    position: relative;
    height: 20px;
    min-height: 20px;
    justify-content: center;
}

.voice-bubble__track-line {
    height: 5px;
    min-height: 5px;
    width: 100%;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.18);
    overflow: hidden;
}

.voice-bubble__progress {
    height: 5px;
    width: 0%;
    border-radius: 3px;
    background-color: var(--accent-text);
}

.voice-bubble__time-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: -2px;
}

.voice-bubble__time {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
}
