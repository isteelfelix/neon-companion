<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="MainView.uss" />

    <ui:VisualElement name="app-root" class="app-root">
        
        <!-- === MAIN LAYOUT === -->
        <ui:VisualElement name="main-layout" class="main-layout">
            
            <!-- LEFT SIDEBAR -->
            <ui:VisualElement name="left-sidebar" class="sidebar left-sidebar">
                <ui:VisualElement class="sidebar-header">
                    <ui:Label text="Neon" class="logo" />
                    <ui:Label text="v0.1" class="version" />
                </ui:VisualElement>

                <ui:VisualElement class="nav-section">
                    <ui:Label text="WORKSPACE" class="section-label" />
                    <ui:Button name="nav-chat" text="Чат" class="nav-item nav-item--active" />
                    <ui:Button name="nav-avatars" text="Аватары" class="nav-item" />
                    <ui:Button name="nav-providers" text="Провайдеры" class="nav-item" />
                </ui:VisualElement>

                <ui:VisualElement class="nav-section">
                    <ui:Label text="LIBRARY" class="section-label" />
                    <ui:Button name="nav-history" text="История" class="nav-item" />
                    <ui:Button name="nav-themes" text="Темы" class="nav-item" />
                    <ui:Button name="nav-settings" text="Настройки" class="nav-item" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CENTER AREA -->
            <ui:VisualElement name="center-area" class="center-area">
                
                <!-- Top Bar -->
                <ui:VisualElement class="topbar">
                    <ui:VisualElement class="topbar-left">
                        <ui:VisualElement class="status-pill">
                            <ui:VisualElement class="status-dot status-dot--green" />
                            <ui:Label text="connected - 14:23" class="status-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="topbar-right">
                        <ui:Button name="provider-button" class="provider-btn">
                            <ui:Label text="OpenAI" />
                            <ui:Label text="gpt-4o-mini" class="model-label" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Avatar Stage -->
                <ui:VisualElement name="avatar-stage" class="stage">
                    <ui:VisualElement name="avatar-glow" class="stage__glow" />
                    <ui:VisualElement name="avatar-circle" class="stage__avatar">
                        <ui:Label text="●" class="stage__placeholder" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Chat Area -->
                <ui:VisualElement name="chat-area" class="chat-area">
                    <ui:ScrollView name="chat-scroll" class="chat-scroll">
                        <ui:VisualElement name="chat-messages" class="chat-messages" />
                    </ui:ScrollView>

                    <!-- Composer -->
                    <ui:VisualElement class="composer">
                        <ui:TextField name="message-input" class="composer__input" placeholder="Напиши Neon что-нибудь..." />
                        <ui:Button name="send-button" class="btn btn--primary" text="→" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Providers Area -->
                <ui:VisualElement name="providers-area" class="providers-area">
                    <ui:VisualElement class="providers-header">
                        <ui:Label text="Providers" class="providers-title" />
                        <ui:Button name="add-provider-btn" text="Add" class="btn btn--primary" />
                    </ui:VisualElement>

                    <ui:ScrollView name="providers-list" class="providers-list" />

                    <ui:VisualElement name="provider-edit-panel" class="provider-edit-panel">
                        <ui:TextField name="edit-name" label="Name" class="provider-field" />
                        <ui:TextField name="edit-baseurl" label="Base URL" class="provider-field" />
                        <ui:TextField name="edit-apikey" label="API Key" class="provider-field" />
                        <ui:TextField name="edit-model" label="Model" class="provider-field" />
                        <ui:Slider name="edit-temperature" label="Temperature" low-value="0" high-value="2" value="0.7" class="provider-field" />
                        <ui:VisualElement class="provider-edit-actions">
                            <ui:Button name="save-provider-btn" text="Save" class="btn btn--primary" />
                            <ui:Button name="cancel-edit-btn" text="Cancel" class="btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- RIGHT SIDEBAR (Sessions) -->
            <ui:VisualElement name="right-sidebar" class="sidebar right-sidebar">
                <ui:VisualElement class="sessions-header">
                    <ui:Label text="Сессии" class="sessions-title" />
                    <ui:Button name="summarize-btn" text="Summarize" class="icon-btn small" />
                </ui:VisualElement>

                <ui:ScrollView name="sessions-list" class="sessions-list" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
