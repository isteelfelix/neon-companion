<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:nc="NeonCompanion.Runtime.UI.UITK">
    <ui:Style src="../Theme/Tokens.uss" />
    <ui:Style src="../Theme/Components.uss" />
    <ui:Style src="MainView.uss" />

    <ui:Template name="ChatView"      src="../Chat/ChatView.uxml" />
    <ui:Template name="ProvidersView" src="../Providers/ProvidersView.uxml" />
    <ui:Template name="AvatarsView"   src="../Avatars/AvatarsView.uxml" />
    <ui:Template name="ThemesView"    src="../Themes/ThemesView.uxml" />
    <ui:Template name="SettingsView"  src="../Settings/SettingsView.uxml" />

    <ui:VisualElement name="app-root" class="app">
        <ui:VisualElement class="app__atmo" />

        <ui:VisualElement name="rail" class="rail">
            <ui:VisualElement class="rail__brand">
                <ui:VisualElement class="brand__mark" />
                <ui:Label text="Neon" class="brand__name" />
                <ui:Label name="brand-version" text="0.2.0" class="brand__tag" />
            </ui:VisualElement>

            <ui:Label text="Рабочее пространство" class="nav__group" />
            <ui:Button name="nav-chat" class="nav__item nav__item--active">
                <ui:VisualElement class="nav__icon icon icon--chat" />
                <ui:Label name="nav-chat-label" text="Чат" class="nav__label" />
                <ui:Label name="nav-chat-count" text="0" class="nav__count" />
            </ui:Button>
            <ui:Button name="nav-avatars" class="nav__item">
                <ui:VisualElement class="nav__icon icon icon--user" />
                <ui:Label name="nav-avatars-label" text="Аватары" class="nav__label" />
                <ui:Label text="8" class="nav__count" />
            </ui:Button>
            <ui:Button name="nav-providers" class="nav__item">
                <ui:VisualElement class="nav__icon icon icon--bolt" />
                <ui:Label name="nav-providers-label" text="Провайдеры" class="nav__label" />
                <ui:Label name="nav-providers-count" text="0" class="nav__count" />
            </ui:Button>

            <ui:Label text="Библиотека" class="nav__group" />
            <ui:Button name="nav-history" class="nav__item">
                <ui:VisualElement class="nav__icon icon icon--history" />
                <ui:Label name="nav-history-label" text="История" class="nav__label" />
            </ui:Button>
            <ui:Button name="nav-themes" class="nav__item">
                <ui:VisualElement class="nav__icon icon icon--palette" />
                <ui:Label name="nav-themes-label" text="Темы" class="nav__label" />
            </ui:Button>
            <ui:Button name="nav-settings" class="nav__item">
                <ui:VisualElement class="nav__icon icon icon--settings" />
                <ui:Label name="nav-settings-label" text="Настройки" class="nav__label" />
            </ui:Button>

            <ui:VisualElement class="rail__divider" />
            <ui:VisualElement class="rail__sessions-head">
                <ui:Label text="Сессии" class="rail__sessions-label" />
                <ui:Button name="history-search-btn" class="iconbtn icon icon--search" tooltip="Поиск сессий" />
                <ui:Button name="new-session-btn" class="iconbtn icon icon--plus" tooltip="Новый чат" />
            </ui:VisualElement>
            <ui:VisualElement name="history-search-bar" class="history__searchbar is-hidden">
                <ui:VisualElement class="icon icon--search history__searchbar-icon" />
                <ui:TextField name="history-search-input" class="history__searchbar-input" placeholder="Поиск…" />
                <ui:Button name="history-search-clear" class="iconbtn icon icon--dots history__searchbar-clear" tooltip="Очистить" />
            </ui:VisualElement>
            <ui:ScrollView name="sessions-list" class="rail__sessions-list" />

            <ui:Button name="nav-close" class="nav__item nav__item--close">
                <ui:VisualElement class="nav__icon icon icon--power" />
                <ui:Label name="nav-close-label" text="Закрыть" class="nav__label" />
            </ui:Button>

            <ui:VisualElement class="rail__footer">
                <ui:VisualElement class="dot--status" />
                <ui:VisualElement class="rail__footer-text">
                    <ui:Label name="rail-provider-name" text="Провайдер не выбран" class="rail__footer-provider" />
                    <ui:Label name="rail-provider-model" text="Модель не выбрана" class="rail__footer-model" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="rail-resize-handle" class="resize-handle" />

        <ui:VisualElement name="main" class="main">
            <ui:VisualElement class="topbar">
                <ui:VisualElement class="topbar__left">
                    <ui:Label name="topbar-title" text="Новый чат" class="topbar__title" />
                    <ui:VisualElement name="topbar-sep" class="topbar__sep" />
                    <ui:Label name="topbar-subtitle" text="" class="topbar__subtitle" />
                    <nc:NeonDropdown name="topbar-model-picker" class="topbar__model-picker" />
                </ui:VisualElement>
                <ui:VisualElement class="topbar__right">
                    <ui:Button name="summarize-btn" text="Резюме" class="btn btn--ghost" />
                    <ui:Button name="export-btn" text="Export" class="btn btn--ghost" />
                    <ui:Button name="search-btn" class="iconbtn icon icon--search" tooltip="Поиск" />
                    <ui:Button name="toggle-left-panel-btn" class="iconbtn icon icon--panel-left" tooltip="Скрыть панель сессий" />
                    <ui:Button name="toggle-right-panel-btn" class="iconbtn icon icon--panel-right" tooltip="Скрыть панель настроек" />
                    <ui:Button name="more-btn" class="iconbtn icon icon--dots" tooltip="Ещё" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-host" class="content-host">
                <ui:Instance template="ChatView"      name="chat-panel"      class="panel panel--active" />
                <ui:VisualElement name="history-panel" class="panel page">
                    <ui:VisualElement class="page__head">
                        <ui:VisualElement class="page__head-copy">
                            <ui:Label text="История чатов" class="page__title" />
                            <ui:Label text="Сохранённые сессии. Выбери, чтобы продолжить диалог." class="page__subtitle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="page__actions">
                            <ui:Button name="history-panel-search-btn" class="iconbtn icon icon--search" tooltip="Поиск сессий" />
                            <ui:Button name="history-panel-new-session-btn" class="iconbtn icon icon--plus" tooltip="Новый чат" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="history-panel-search-bar" class="history__searchbar is-hidden">
                        <ui:VisualElement class="icon icon--search history__searchbar-icon" />
                        <ui:TextField name="history-panel-search-input" class="history__searchbar-input" placeholder="Поиск…" />
                        <ui:Button name="history-panel-search-clear" class="iconbtn icon icon--dots history__searchbar-clear" tooltip="Очистить" />
                    </ui:VisualElement>
                    <ui:Label name="history-panel-state" class="history-panel__state" />
                    <ui:ScrollView name="history-panel-sessions-list" class="history-panel__list" />
                </ui:VisualElement>
                <ui:Instance template="ProvidersView" name="providers-panel" class="panel" />
                <ui:Instance template="AvatarsView"   name="avatars-panel"   class="panel" />
                <ui:Instance template="ThemesView"    name="themes-panel"    class="panel" />
                <ui:Instance template="SettingsView"  name="settings-panel"  class="panel" />
                <ui:VisualElement name="placeholder-area" class="panel">
                    <ui:Label name="placeholder-title" text="Раздел недоступен" class="page__title" />
                    <ui:Label name="placeholder-body" text="Содержимое для этого раздела сейчас не отображается." class="page__subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="quit-overlay" class="quit-overlay">
            <ui:VisualElement name="quit-dialog" class="quit-dialog">
                <ui:Label name="quit-dialog-title" text="Закрыть приложение?" class="quit-dialog__title" />
                <ui:Label name="quit-dialog-body" text="Активные соединения будут прерваны." class="quit-dialog__body" />
                <ui:VisualElement class="quit-dialog__actions">
                    <ui:Button name="quit-cancel-btn" text="Отмена" class="btn btn--ghost" />
                    <ui:Button name="quit-confirm-btn" class="btn btn--danger">
                        <ui:VisualElement class="icon icon--power btn__icon" />
                        <ui:Label text="Закрыть" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
