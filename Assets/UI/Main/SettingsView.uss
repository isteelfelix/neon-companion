/* ============== Settings page ==============
   Drop-in addon: include AFTER MainView.uss in MainView.uxml.
   Targets the #settings-area section.
*/

.settings-page {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    padding: 16px 20px 0 20px;
}

.settings-scroll {
    flex-grow: 1;
    padding-bottom: 20px;
}

/* ---- card ---- */
.settings-card {
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 10px;
    padding: 10px 14px 4px 14px;
    margin-bottom: 10px;
}

.settings-card__head {
    flex-direction: row;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    margin-bottom: 6px;
}
.settings-card__icon {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--accent);
}
.settings-card__title {
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-SemiBold.ttf");
    color: var(--text-0);
}

/* ---- row ---- */
.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 7px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
}
.settings-row__copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin-right: 12px;
}
.settings-row__name {
    font-size: 12px;
    color: var(--text-0);
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-Medium.ttf");
    margin-bottom: 3px;
}
.settings-row__sub {
    font-size: 10px;
    color: var(--text-3);
    white-space: normal;
}
.settings-row__sub--mono {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}
.settings-row__value-mono {
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    font-size: 12px;
    color: var(--text-2);
}
.settings-row--compact {
    padding: 4px 0;
}
.settings-row--danger .settings-row__name {
    color: var(--danger);
}

/* ---- dropdown ---- */
.settings-dropdown {
    min-width: 160px;
}

/* ---- toggle (Unity native, restyled as pill) ---- */
.settings-toggle {
    margin: 0;
    width: 36px;
    min-width: 36px;
    height: 20px;
    flex-shrink: 0;
}
.settings-toggle .unity-toggle__input {
    width: 36px;
    min-width: 36px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 999px;
    background-color: var(--bg-4);
    border-width: 1px;
    border-color: var(--line-2);
    padding: 0;
    justify-content: flex-start;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.settings-toggle .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    margin: 2px;
    border-radius: 999px;
    background-color: var(--text-2);
    background-image: none;
    border-width: 0;
    transition-property: translate, background-color;
    transition-duration: 0.18s;
}
.settings-toggle:checked .unity-toggle__input {
    background-color: var(--accent);
    border-color: var(--accent);
}
.settings-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(255, 255, 255);
    translate: 16px 0px;
}
.settings-toggle .unity-toggle__text {
    display: none;
}

/* ---- segmented control (avatar shape) ---- */
.seg {
    flex-direction: row;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 2px;
}
.seg__btn {
    height: 28px;
    padding: 0 12px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-Medium.ttf");
    margin: 0;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}
.seg__btn:hover {
    color: var(--text-0);
}
.seg__btn--active {
    background-color: var(--bg-3);
    color: var(--text-0);
}

/* ---- danger button ---- */
.btn--danger {
    background-color: rgba(226, 112, 71, 0.12);
    border-color: rgba(226, 112, 71, 0.4);
    color: var(--danger);
}
.btn--danger:hover {
    background-color: rgba(226, 112, 71, 0.2);
    border-color: var(--danger);
}

/* ---- button with icon ---- */
.btn__icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    -unity-background-image-tint-color: var(--text-1);
}
.btn--danger .btn__icon {
    -unity-background-image-tint-color: var(--danger);
}

/* ---- about actions row ---- */
.settings-actions-row {
    border-bottom-width: 0;
    padding-top: 14px;
    justify-content: flex-start;
}
.settings-actions-row > Button {
    margin-right: 8px;
}

/* ---- icons used on settings page ---- */
.icon--globe    { background-image: url("project://database/Assets/UI/Icons/globe.svg"); }
.icon--shield   { background-image: url("project://database/Assets/UI/Icons/shield.svg"); }
.icon--folder   { background-image: url("project://database/Assets/UI/Icons/folder.svg"); }
.icon--trash    { background-image: url("project://database/Assets/UI/Icons/trash.svg"); }
.icon--info     { background-image: url("project://database/Assets/UI/Icons/info.svg"); }
.icon--external { background-image: url("project://database/Assets/UI/Icons/external.svg"); }
.icon--download { background-image: url("project://database/Assets/UI/Icons/download.svg"); }
.icon--heart    { background-image: url("project://database/Assets/UI/Icons/heart.svg"); }
