/* ============================================================
   MainView — app shell: rail, topbar, content host
   Page-specific styles live in each view's own .uss file.
   ============================================================ */

.app {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--bg-0);
    color: var(--text-1);
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-Regular.ttf");
}

/* left must track .rail's width — the backdrop starts where the rail ends. */
.app__atmo {
    position: absolute;
    left: 212px;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Avatars/atmo.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.is-hidden {
    display: none;
}

/* ============== Icons ============== */

.icon {
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-2);
}

.icon--active,
.nav__item--active .nav__icon {
    -unity-background-image-tint-color: var(--accent);
}

.icon--arrow      { background-image: url("project://database/Assets/UI/Icons/arrow.svg"); }
.icon--attach     { background-image: url("project://database/Assets/UI/Icons/attach.svg"); }
.icon--bolt       { background-image: url("project://database/Assets/UI/Icons/bolt.svg"); }
.icon--chat       { background-image: url("project://database/Assets/UI/Icons/chat.svg"); }
.icon--check      { background-image: url("project://database/Assets/UI/Icons/check.svg"); }
.icon--copy       { background-image: url("project://database/Assets/UI/Icons/copy.svg"); }
.icon--dots       { background-image: url("project://database/Assets/UI/Icons/dots.svg"); }
.icon--headphones { background-image: url("project://database/Assets/UI/Icons/headphones.svg"); }
.icon--mic        { background-image: url("project://database/Assets/UI/Icons/mic.svg"); }
.icon--history    { background-image: url("project://database/Assets/UI/Icons/history.svg"); }
.icon--palette      { background-image: url("project://database/Assets/UI/Icons/palette.svg"); }
.icon--panel-left   { background-image: url("project://database/Assets/UI/Icons/panel-left.svg"); }
.icon--hamburger  { background-image: url("project://database/Assets/UI/Icons/hamburger.svg"); }
.icon--panel-right  { background-image: url("project://database/Assets/UI/Icons/panel-right.svg"); }
.icon--plus         { background-image: url("project://database/Assets/UI/Icons/plus.svg"); }
.icon--refresh    { background-image: url("project://database/Assets/UI/Icons/refresh.svg"); }
.icon--search     { background-image: url("project://database/Assets/UI/Icons/search.svg"); }
.icon--send       { background-image: url("project://database/Assets/UI/Icons/send.svg"); }
.icon--settings   { background-image: url("project://database/Assets/UI/Icons/settings.svg"); }
.icon--sparkle    { background-image: url("project://database/Assets/UI/Icons/sparkle.svg"); }
.icon--upload     { background-image: url("project://database/Assets/UI/Icons/upload.svg"); }
.icon--user       { background-image: url("project://database/Assets/UI/Icons/user.svg"); }
.icon--power      { background-image: url("project://database/Assets/UI/Icons/power.svg"); }
.icon--eye        { background-image: url("project://database/Assets/UI/Icons/eye.svg"); }
.icon--eye-off    { background-image: url("project://database/Assets/UI/Icons/eye-off.svg"); }

/* ============== Rail ============== */

.rail {
    width: 212px;
    flex-shrink: 0;
    background-color: var(--bg-1);
    border-right-width: 1px;
    border-right-color: var(--line-1);
    flex-direction: column;
    padding: 6px 8px;
    overflow: hidden;
    min-height: 0;
}

.rail__brand {
    height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    margin-bottom: 2px;
}

.brand__mark {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 6px;
    background-image: url("project://database/Assets/UI/Branding/app-icon-1024.png");
    -unity-background-scale-mode: stretch-to-fill;
    margin-right: 8px;
}

.brand__name {
    color: var(--text-0);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.brand__tag {
    color: var(--text-3);
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 5px;
    padding: 1px 5px;
    font-size: 9px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    flex-shrink: 0;
}

.nav__group {
    padding: 6px 6px 2px;
    color: var(--text-4);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    -unity-font-style: bold;
    flex-shrink: 0;
}

.nav__item {
    height: 26px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
    /* Explicit on all four sides: Unity's default Button margin would otherwise
       reintroduce the gap the 1px rhythm is meant to remove. */
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 1px;
    background-color: rgba(0, 0, 0, 0);
    /* Button reset */
    -unity-font-style: normal;
}

.nav__item:hover {
    background-color: var(--bg-2);
}

.nav__item--active {
    background-color: var(--bg-3);
    border-color: var(--line-2);
}

.nav__icon {
    width: 14px;
    height: 14px;
    margin-right: 8px;
}

.nav__label {
    font-size: 12px;
    color: var(--text-2);
    flex-grow: 1;
    overflow: hidden;
}

.nav__item:hover .nav__label {
    color: var(--text-1);
}

.nav__item--active .nav__label {
    color: var(--text-0);
}

.nav__count {
    color: var(--text-3);
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.rail__spacer {
    display: none;
}

/* Height follows content: in Hermes mode the model line moves into the profile caption,
   and a fixed 38px would keep reserving room for a line that is no longer there. */
.rail__footer {
    min-height: 18px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: var(--line-1);
    padding-top: 5px;
    flex-direction: row;
    align-items: center;
}

.dot--status {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--ok);
    margin-right: 8px;
}

.rail__footer-text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.rail__footer-provider {
    font-size: 11px;
    color: var(--text-1);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Hermes backend profile strip (created in C#, sits under the provider indicator).
   A dropdown does not work here: the rail is ~208px of usable width, and the row is
   the last element of the rail, so the popup opened past the bottom of the window.
   Icon chips + drag-to-scroll instead — see ProvidersController.EnsureProfileSelector. */
.rail__profile {
    flex-direction: column;
    flex-shrink: 0;
    padding-top: 4px;
    padding-bottom: 0;
}

.rail__profile-label {
    flex-shrink: 0;
    font-size: 9px;
    color: var(--text-4);
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    margin-right: 6px;
}

.rail__profile-strip {
    height: 22px;
    flex-shrink: 0;
}

.rail__profile-strip:disabled {
    opacity: 0.45;
}

.rail__profile-chip {
    width: 22px;
    height: 22px;
    /* Never squeeze: overflow is what the drag-scroll exists for. */
    flex-shrink: 0;
    margin-right: 4px;
    border-radius: var(--r-md);
    /* Border width is constant so the active ring cannot shift the glyph. */
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    opacity: 0.62;
}

/* Kept apart from the geometry above: Unity drops a whole rule block when one
   property in it is invalid, and the chips must not lose their size over a
   transition tweak. */
.rail__profile-chip {
    transition-property: border-color, scale;
    transition-duration: 120ms, 120ms;
}

.rail__profile-chip:hover {
    border-color: var(--line-3);
    opacity: 0.85;
}

/* The active profile: full opacity, bright ring, filled background (set inline from the
   profile's hue). The previous 1px translucent ring was invisible on a dark rail. */
.rail__profile-chip--active {
    border-color: var(--accent-text);
    opacity: 1;
}

/* Separate block for the same reason as the transition above — the ring is what actually
   marks the active profile and must survive on its own. */
.rail__profile-chip--active {
    scale: 1.08 1.08;
}

/* Colour comes from the chip (inline, per profile) — `color` is inherited in USS. */
.rail__profile-chip-glyph {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.rail__profile-chip-default {
    position: absolute;
    top: 1px;
    right: 1px;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: var(--text-0);
}

/* Tag, name and model share one row — this block used to cost six lines in the rail. */
.rail__profile-caption {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.rail__profile-status {
    font-size: 11px;
    color: var(--text-1);
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* Profile names are short ids, model names are not — the model yields the space. */
.rail__profile-meta {
    flex-shrink: 1;
    font-size: 10px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-left: 5px;
}

.rail__footer-model {
    font-size: 10px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ============== Main shell ============== */

.main {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.topbar {
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    background-color: var(--bg-1);
}

.topbar__left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.topbar__title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-0);
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.topbar__subtitle {
    font-size: 10px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.topbar__model-picker {
    margin-left: 8px;
    max-width: 180px;
}

.topbar__sep {
    width: 1px;
    height: 14px;
    background-color: var(--line-2);
    margin-left: 8px;
    margin-right: 8px;
}

.topbar__right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.topbar__right > Button {
    margin-left: 4px;
}

.iconbtn {
    width: 26px;
    height: 26px;
    min-width: 26px;
    min-height: 26px;
    padding: 6px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
}

.iconbtn:hover {
    background-color: var(--bg-3);
    -unity-background-image-tint-color: var(--text-0);
}

/* ============== Content host + panels ============== */

.content-host {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.panel {
    display: none;
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.panel--active {
    display: flex;
}

/* ============== Shared page layout ============== */

.page {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.page__head {
    min-height: 34px;
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 14px;
}

.page__head-copy {
    flex-grow: 1;
    flex-direction: column;
}

.page__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-0);
    margin-bottom: 2px;
}

.page__subtitle {
    font-size: 12px;
    color: var(--text-3);
    white-space: normal;
}

.page__actions {
    flex-direction: row;
    align-items: center;
}

.page__actions > Button {
    margin-left: 6px;
}

/* ---- Rail sessions ---- */

.rail__divider {
    height: 1px;
    background-color: var(--line-1);
    margin: 4px 0 2px;
    flex-shrink: 0;
}

.rail__sessions-head {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px 2px 6px;
    flex-shrink: 0;
}

.rail__sessions-label {
    flex-grow: 1;
    font-size: 9px;
    color: var(--text-4);
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.rail__sessions-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 1px 2px;
}

/* ---- Placeholder page ---- */

.placeholder-page {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 16px 20px 20px;
}

/* ---- History panel ---- */

.history-panel__state {
    color: var(--text-3);
    font-size: 12px;
    margin-bottom: 8px;
}

.history-panel__state--error {
    color: #ffb4b4;
}

.history-panel__list {
    flex-grow: 1;
    min-height: 0;
    padding: 2px 4px;
}

.history__searchbar {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: var(--r-sm);
    background-color: var(--bg-1);
    margin-bottom: 8px;
    padding: 0 3px;
}

.history__searchbar-icon {
    width: 14px;
    height: 14px;
    opacity: 0.65;
    margin-left: 8px;
}

.history__searchbar-input {
    flex-grow: 1;
    margin: 0 4px;
}

.history__searchbar-input > .unity-text-field__input,
.history__searchbar-input > .unity-base-text-field__input {
    border-width: 0;
    background-color: transparent;
    color: var(--text-1);
    font-size: 12px;
}

.history__searchbar-clear {
    width: 22px;
    height: 22px;
}

.history__group {
    color: var(--text-4);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
    margin: 6px 6px 3px;
}

.history__item {
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    padding: 5px 8px;
    margin-bottom: 2px;
    min-width: 0;
    overflow: hidden;
}

.history__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    min-width: 0;
}

.history__item:hover {
    background-color: var(--bg-2);
}

.history__item--active {
    border-color: var(--accent-glow);
    background-color: var(--accent-soft);
}

.history__title {
    color: var(--text-0);
    font-size: 12px;
    -unity-font-style: bold;
    flex-grow: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.history__provider {
    color: var(--accent-2);
    background-color: var(--accent-soft);
    border-radius: 5px;
    padding: 1px 6px;
    font-size: 9px;
    -unity-font-style: bold;
    flex-shrink: 0;
    max-width: 48%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.history__meta {
    color: var(--text-3);
    font-size: 11px;
}

/* Session delete button */
.history__delete-btn {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    padding: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: var(--text-3);
    font-size: 14px;
    display: none;
    flex-shrink: 0;
    margin-left: auto;
    align-items: center;
    justify-content: center;
}

.history__item:hover .history__delete-btn {
    display: flex;
}

.history__delete-btn:hover,
.history__delete-btn--confirm {
    background-color: rgba(239, 100, 100, 0.15);
    border-color: rgba(239, 100, 100, 0.30);
    color: #ef6464;
}

/* ============== Nav close button ============== */

.nav__item--close {
    margin-top: 2px;
    opacity: 0.55;
}

.nav__item--close:hover {
    opacity: 1.0;
}

/* ============== Quit confirmation overlay ============== */

.quit-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.quit-dialog {
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 16px 18px;
    min-width: 260px;
    max-width: 340px;
}

.quit-dialog__title {
    font-size: 14px;
    color: var(--text-0);
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-SemiBold.ttf");
    margin-bottom: 6px;
}

.quit-dialog__body {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 14px;
    white-space: normal;
}

.quit-dialog__actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.quit-dialog__actions > Button {
    margin-left: 8px;
}


/* Platform / mobile / form-factor responsive rules are consolidated at the
   end of this file (see "Responsive — form factors"). */

/* ============================================================
   Desktop responsive — borderless resizable window (min 760×560).
   Breakpoint classes app--compact / app--narrow are toggled from C#
   (LayoutController) on root width. The avatar (right) panel auto-hide
   is handled in C# (display), not here, to avoid clashing with the
   inline width set by PanelResizeHandler.
   ============================================================ */

/* Let shell areas shrink below their content width instead of overflowing. */
.main,
.content-host,
.composer {
    min-width: 0;
}

/* --- Compact (<1000px): declutter the topbar, free horizontal space --- */
.app--compact .topbar {
    padding-left: 10px;
    padding-right: 10px;
}

.app--compact .topbar__right > Button {
    margin-left: 3px;
}

.app--compact .topbar__model-picker {
    max-width: 140px;
    margin-left: 6px;
}

/* Ghost text buttons (Резюме / Export) drop out first — they overlap at
   narrow widths and stay reachable when the window is widened. */
.app--compact .topbar__right > .btn--ghost {
    display: none;
}

/* --- Narrow (<820px): strip the topbar subtitle + separator --- */
.app--narrow .topbar__subtitle,
.app--narrow .topbar__sep {
    display: none;
}

.app--narrow .topbar {
    padding-left: 8px;
    padding-right: 8px;
}

/* ============================================================
   Rail density — компактнее кнопки сессий и плитки сессий.
   ============================================================ */
.rail__sessions-head .iconbtn,
.history__searchbar-clear {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    padding: 4px;
}

/* Плитки сессий в рейле: одна строка-заголовок, плотный ритм (как в Claude Code). */
.rail__sessions-list .history__item {
    padding: 1px 6px;
    margin-bottom: 0;
    border-radius: 5px;
}

.rail__sessions-list .history__row {
    margin-bottom: 0;
    min-height: 18px;
}

.rail__sessions-list .history__title {
    font-size: 11px;
    -unity-font-style: normal;
    color: var(--text-2);
}

.rail__sessions-list .history__delete-btn {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    font-size: 12px;
    border-radius: 5px;
}

.rail__sessions-list .history__item:hover .history__title,
.rail__sessions-list .history__item--active .history__title {
    color: var(--text-0);
}

/* Группировку («Недавние»/по датам) в рейле убираем — просто список плиток. */
.rail__sessions-list .history__group {
    display: none;
}

/* Чип провайдера в плитках рейла — мусор, убираем (в панели Истории остаётся). */
.rail__sessions-list .history__item .history__provider {
    display: none;
}

/* Счётчик сообщений скрываем — он дублирует инфу и раздувает плитку по высоте.
   Селектор именно внутри плитки, чтобы не задеть пустой статус «нет сессий». */
.rail__sessions-list .history__item .history__meta {
    display: none;
}

/* ============================================================
   Responsive — form factors
   ResponsiveLayoutController (LayoutController) sets exactly one of
   ff-phone / ff-tablet / ff-desktop on .app (#app-root) from the real
   logical width (PanelSettings = ConstantPhysicalSize → physical points).
   Drawer/overlay open-state is toggled via rail--open / avatar--open;
   paint order is handled in C# with BringToFront() (USS has no z-index).
   ============================================================ */

/* ---- Visibility helpers ---- */
.mobile-only        { display: none; }
.ff-phone .mobile-only  { display: flex; }
.ff-phone .desktop-only { display: none; }

/* ---- Touch targets (phone + tablet) ----
   40px is the floor that still reads as tappable; the old 44px added a visible
   band of dead space to every row on a phone-sized screen. Density elsewhere is
   handled by padding, not by shrinking these below 40. */
.ff-phone .iconbtn,
.ff-phone .nav__item,
.ff-phone .composer__send,
.ff-tablet .iconbtn {
    min-width: 40px;
    min-height: 40px;
}

/* Tablet keeps the desktop rail rows; only the icon buttons need the tap floor. */
.ff-tablet .iconbtn {
    min-width: 32px;
    min-height: 32px;
}

/* ============================================================
   Phone — single column, rail as off-canvas drawer
   ============================================================ */

/* Rail becomes an absolute drawer, sliding in from the left over a scrim.
   position:absolute removes it from the flex row → main fills full width. */
.ff-phone .rail {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 300px;
    max-width: 86%;
    translate: -100% 0;
    transition: translate 180ms ease-out;
    border-right-width: 1px;
    border-right-color: var(--line-2);
}

.ff-phone .rail.rail--open {
    translate: 0 0;
}

/* Larger nav rows inside the drawer — 40px is the tap floor, not a comfort margin. */
.ff-phone .nav__item {
    height: 40px;
    padding: 6px 10px;
}

/* No drag-resize handles on phone (rail/avatar are overlays). */
.ff-phone .resize-handle {
    display: none;
}

/* Atmospheric backdrop is offset by the rail on desktop; full-bleed on phone. */
.ff-phone .app__atmo {
    left: 0;
}

/* Scrim behind the drawer. Created in C#; click closes the drawer. */
.app-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

/* ---- Topbar density on phone ---- */
.ff-phone .topbar {
    height: 44px;
    padding-left: 8px;
    padding-right: 8px;
}

.ff-phone .topbar__subtitle,
.ff-phone .topbar__sep,
.ff-phone .topbar__right > .btn--ghost {
    display: none;
}

/* The left/right panel toggles are desktop affordances; phone uses the
   hamburger (left) and re-purposes the right toggle for the avatar overlay. */
.ff-phone #toggle-left-panel-btn {
    display: none;
}

/* Model picker is set display:flex inline (C#), so we only constrain its width
   here — keep it compact so the title keeps room on a narrow topbar. */
.ff-phone .topbar__model-picker {
    max-width: 108px;
    margin-left: 8px;
}

/* Hamburger: ensure a comfortable, clearly-visible tap target on phone. */
.ff-phone #mobile-menu-btn {
    margin-right: 4px;
}

/* ============================================================
   Phone — page reflow (Providers / Avatars / Settings / History)
   These pages were laid out for a wide desktop column; on a narrow
   phone the header action rows and dropdowns overflow off-screen.
   ============================================================ */

/* Stack the page header so action buttons wrap below the title/subtitle
   instead of running off the right edge. */
.ff-phone .page__head {
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    margin-bottom: 10px;
}

.ff-phone .page__actions {
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-top: 6px;
}

.ff-phone .page__actions > Button {
    margin-left: 0;
    margin-right: 6px;
    margin-bottom: 4px;
}

.ff-phone .page__title {
    font-size: 16px;
}

/* Page gutters: the desktop 16/20 inset costs ~10% of a phone's width for nothing.
   Every page root is listed because each view owns its own padding declaration. */
.ff-phone .placeholder-page,
.ff-phone .providers-page,
.ff-phone .avatars-page,
.ff-phone .themes-page,
.ff-phone .settings-page {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
}

.ff-phone .chat-main {
    padding: 6px 8px 8px;
}

/* Keep the scrollbar-bleed trick in sync with the phone gutter above. */
.ff-phone .transcript {
    margin-right: -8px;
    padding-right: 4px;
}

.ff-phone .transcript__row {
    padding-right: 6px;
}

/* Dropdowns must never force horizontal overflow on a narrow screen. */
.ff-phone .neon-dropdown,
.ff-phone .neon-dropdown__trigger {
    max-width: 100%;
}

/* Avatar filter chips wrap onto multiple rows instead of clipping. */
.ff-phone .filterrow {
    flex-wrap: wrap;
}

/* ============================================================
   Android / iOS — system inset breathing room (added to safe-area padding)
   ============================================================ */
.platform-android .composer {
    padding-bottom: 10px;
}

.platform-ios .composer {
    padding-bottom: 14px;
}
