/* ============ Calm Productivity — Avatar-first layout ============ */

.app-root {
    flex-grow: 1;
    background-color: rgb(16, 17, 21);
    padding: 16px;
}

.main-layout {
    flex-grow: 1;
    flex-direction: row;
    gap: 12px;
}

/* ============ SIDEBARS ============ */

.sidebar {
    width: 220px;
    background-color: rgb(22, 24, 29);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(40, 44, 52);
    padding: 12px;
    flex-shrink: 0;
}

.left-sidebar {
    width: 210px;
}

.right-sidebar {
    width: 260px;
}

.sidebar-header {
    padding: 8px 12px;
    margin-bottom: 16px;
}

.logo {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 232, 236);
}

.version {
    font-size: 11px;
    color: rgb(100, 110, 125);
}

.nav-section {
    margin-bottom: 20px;
}

.section-label {
    font-size: 10px;
    color: rgb(90, 100, 115);
    -unity-font-style: bold;
    padding: 0 12px;
    margin-bottom: 6px;
    letter-spacing: 1px;
}

.nav-item {
    width: 100%;
    height: 36px;
    padding: 0 14px;
    margin-bottom: 2px;
    border-radius: 8px;
    background-color: transparent;
    color: rgb(180, 188, 200);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.nav-item:hover {
    background-color: rgb(28, 30, 36);
    color: rgb(220, 224, 232);
}

.nav-item--active {
    background-color: rgb(40, 44, 52);
    color: rgb(230, 232, 236);
}

/* ============ CENTER AREA ============ */

.center-area {
    flex-grow: 1;
    background-color: rgb(22, 24, 29);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(40, 44, 52);
    padding: 16px;
    flex-direction: column;
}

/* Top Bar */
.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.status-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 30, 36);
    border-radius: 999px;
    padding: 4px 12px;
    gap: 8px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

.status-dot--green {
    background-color: rgb(80, 200, 120);
}

.status-text {
    font-size: 12px;
    color: rgb(160, 170, 185);
}

.provider-btn {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 30, 36);
    border-radius: 999px;
    padding: 6px 14px;
    gap: 8px;
    border-width: 1px;
    border-color: rgb(50, 55, 65);
}

.model-label {
    font-size: 11px;
    color: rgb(130, 140, 155);
}

/* Avatar Stage */
.stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 20px;
}

.stage__glow {
    position: absolute;
    width: 340px;
    height: 340px;
    border-radius: 170px;
    background-color: rgba(90, 120, 240, 0.15);
}

.stage__avatar {
    width: 240px;
    height: 240px;
    border-radius: 120px;
    background-color: rgb(30, 33, 40);
    border-width: 1px;
    border-color: rgb(50, 55, 64);
    align-items: center;
    justify-content: center;
}

/* Chat Area */
.chat-area {
    flex-direction: column;
    flex-grow: 1;
    min-height: 220px;
}

.chat-scroll {
    flex-grow: 1;
    margin-bottom: 12px;
}

.chat-messages {
    flex-direction: column;
    gap: 8px;
}

/* Composer */
.composer {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.composer__input {
    flex-grow: 1;
    height: 44px;
}

.composer__input > .unity-text-field__input {
    background-color: rgb(28, 30, 36);
    border-color: rgb(45, 49, 58);
    border-radius: 10px;
    color: rgb(230, 232, 236);
    padding: 0 16px;
}

/* Buttons */
.btn {
    height: 44px;
    padding: 0 20px;
    border-radius: 10px;
    border-width: 1px;
    font-size: 14px;
    -unity-font-style: bold;
}

.btn--primary {
    background-color: rgb(90, 120, 240);
    color: rgb(245, 247, 255);
    border-color: rgb(90, 120, 240);
}

/* ============ RIGHT SIDEBAR (SESSIONS) ============ */

.sessions-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 0 8px;
}

.sessions-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 232, 236);
}

.sessions-list {
    flex-grow: 1;
}

.session-item {
    padding: 10px 12px;
    margin-bottom: 4px;
    border-radius: 8px;
    background-color: rgb(28, 30, 36);
}

.session-item:hover {
    background-color: rgb(35, 38, 45);
}

.session-title {
    font-size: 13px;
    color: rgb(220, 224, 232);
    margin-bottom: 4px;
}

.session-meta {
    font-size: 11px;
    color: rgb(120, 130, 145);
}