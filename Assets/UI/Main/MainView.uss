/* ============================================================
   MainView — app shell: rail, topbar, content host
   Page-specific styles live in each view's own .uss file.
   ============================================================ */

.app {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--bg-0);
    color: var(--text-1);
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-Regular.ttf");
}

.app__atmo {
    position: absolute;
    left: 232px;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Avatars/atmo.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.is-hidden {
    display: none;
}

/* ============== Icons ============== */

.icon {
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-2);
}

.icon--active,
.nav__item--active .nav__icon {
    -unity-background-image-tint-color: var(--accent);
}

.icon--arrow      { background-image: url("project://database/Assets/UI/Icons/arrow.svg"); }
.icon--attach     { background-image: url("project://database/Assets/UI/Icons/attach.svg"); }
.icon--bolt       { background-image: url("project://database/Assets/UI/Icons/bolt.svg"); }
.icon--chat       { background-image: url("project://database/Assets/UI/Icons/chat.svg"); }
.icon--check      { background-image: url("project://database/Assets/UI/Icons/check.svg"); }
.icon--copy       { background-image: url("project://database/Assets/UI/Icons/copy.svg"); }
.icon--dots       { background-image: url("project://database/Assets/UI/Icons/dots.svg"); }
.icon--headphones { background-image: url("project://database/Assets/UI/Icons/headphones.svg"); }
.icon--mic        { background-image: url("project://database/Assets/UI/Icons/mic.svg"); }
.icon--history    { background-image: url("project://database/Assets/UI/Icons/history.svg"); }
.icon--palette      { background-image: url("project://database/Assets/UI/Icons/palette.svg"); }
.icon--panel-left   { background-image: url("project://database/Assets/UI/Icons/panel-left.svg"); }
.icon--hamburger  { background-image: url("project://database/Assets/UI/Icons/hamburger.svg"); }
.icon--panel-right  { background-image: url("project://database/Assets/UI/Icons/panel-right.svg"); }
.icon--plus         { background-image: url("project://database/Assets/UI/Icons/plus.svg"); }
.icon--refresh    { background-image: url("project://database/Assets/UI/Icons/refresh.svg"); }
.icon--search     { background-image: url("project://database/Assets/UI/Icons/search.svg"); }
.icon--send       { background-image: url("project://database/Assets/UI/Icons/send.svg"); }
.icon--settings   { background-image: url("project://database/Assets/UI/Icons/settings.svg"); }
.icon--sparkle    { background-image: url("project://database/Assets/UI/Icons/sparkle.svg"); }
.icon--upload     { background-image: url("project://database/Assets/UI/Icons/upload.svg"); }
.icon--user       { background-image: url("project://database/Assets/UI/Icons/user.svg"); }
.icon--power      { background-image: url("project://database/Assets/UI/Icons/power.svg"); }
.icon--eye        { background-image: url("project://database/Assets/UI/Icons/eye.svg"); }
.icon--eye-off    { background-image: url("project://database/Assets/UI/Icons/eye-off.svg"); }

/* ============== Rail ============== */

.rail {
    width: 232px;
    flex-shrink: 0;
    background-color: var(--bg-1);
    border-right-width: 1px;
    border-right-color: var(--line-1);
    flex-direction: column;
    padding: 10px 12px;
    overflow: hidden;
    min-height: 0;
}

.rail__brand {
    height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 10px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    margin-bottom: 4px;
}

.brand__mark {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 8px;
    background-image: url("project://database/Assets/UI/Branding/app-icon-1024.png");
    -unity-background-scale-mode: stretch-to-fill;
    margin-right: 10px;
}

.brand__name {
    color: var(--text-0);
    font-size: 15px;
    -unity-font-style: bold;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.brand__tag {
    color: var(--text-3);
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    flex-shrink: 0;
}

.nav__group {
    padding: 2px 10px 2px;
    color: var(--text-4);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    -unity-font-style: bold;
    flex-shrink: 0;
}

.nav__item {
    height: 30px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0);
    /* Button reset */
    -unity-font-style: normal;
}

.nav__item:hover {
    background-color: var(--bg-2);
}

.nav__item--active {
    background-color: var(--bg-3);
    border-color: var(--line-2);
}

.nav__icon {
    width: 16px;
    height: 16px;
    margin-right: 10px;
}

.nav__label {
    font-size: 12px;
    color: var(--text-2);
    flex-grow: 1;
    overflow: hidden;
}

.nav__item:hover .nav__label {
    color: var(--text-1);
}

.nav__item--active .nav__label {
    color: var(--text-0);
}

.nav__count {
    color: var(--text-3);
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.rail__spacer {
    display: none;
}

.rail__footer {
    height: 38px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: var(--line-1);
    padding-top: 8px;
    flex-direction: row;
    align-items: center;
}

.dot--status {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--ok);
    margin-right: 10px;
}

.rail__footer-text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.rail__footer-provider {
    font-size: 12px;
    color: var(--text-1);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.rail__footer-model {
    font-size: 10px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ============== Main shell ============== */

.main {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.topbar {
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 22px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    background-color: var(--bg-1);
}

.topbar__left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.topbar__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-0);
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.topbar__subtitle {
    font-size: 11px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.topbar__model-picker {
    margin-left: 12px;
    max-width: 200px;
}

.topbar__sep {
    width: 1px;
    height: 18px;
    background-color: var(--line-2);
    margin-left: 12px;
    margin-right: 12px;
}

.topbar__right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.topbar__right > Button {
    margin-left: 8px;
}

.iconbtn {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    padding: 7px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
}

.iconbtn:hover {
    background-color: var(--bg-3);
    -unity-background-image-tint-color: var(--text-0);
}

/* ============== Content host + panels ============== */

.content-host {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.panel {
    display: none;
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.panel--active {
    display: flex;
}

/* ============== Shared page layout ============== */

.page {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.page__head {
    min-height: 64px;
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 28px;
}

.page__head-copy {
    flex-grow: 1;
    flex-direction: column;
}

.page__title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text-0);
    margin-bottom: 4px;
}

.page__subtitle {
    font-size: 13px;
    color: var(--text-3);
    white-space: normal;
}

.page__actions {
    flex-direction: row;
    align-items: center;
}

.page__actions > Button {
    margin-left: 8px;
}

/* ---- Rail sessions ---- */

.rail__divider {
    height: 1px;
    background-color: var(--line-1);
    margin: 4px 0 2px;
    flex-shrink: 0;
}

.rail__sessions-head {
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 2px;
    flex-shrink: 0;
}

.rail__sessions-label {
    flex-grow: 1;
    font-size: 10px;
    color: var(--text-4);
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.rail__sessions-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 1px 2px;
}

/* ---- Placeholder page ---- */

.placeholder-page {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 28px 36px 36px;
}

/* ---- History panel ---- */

.history-panel__state {
    color: var(--text-3);
    font-size: 13px;
    margin-bottom: 10px;
}

.history-panel__state--error {
    color: #ffb4b4;
}

.history-panel__list {
    flex-grow: 1;
    min-height: 0;
    padding: 2px 4px;
}

.history__searchbar {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: var(--r-sm);
    background-color: var(--bg-1);
    margin-bottom: 12px;
    padding: 0 4px;
}

.history__searchbar-icon {
    width: 14px;
    height: 14px;
    opacity: 0.65;
    margin-left: 8px;
}

.history__searchbar-input {
    flex-grow: 1;
    margin: 0 4px;
}

.history__searchbar-input > .unity-text-field__input,
.history__searchbar-input > .unity-base-text-field__input {
    border-width: 0;
    background-color: transparent;
    color: var(--text-1);
    font-size: 13px;
}

.history__searchbar-clear {
    width: 26px;
    height: 26px;
}

.history__group {
    color: var(--text-4);
    font-size: 10px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
    margin: 8px 8px 4px;
}

.history__item {
    border-radius: var(--r-sm);
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    padding: 8px 10px;
    margin-bottom: 4px;
    min-width: 0;
    overflow: hidden;
}

.history__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    min-width: 0;
}

.history__item:hover {
    background-color: var(--bg-2);
}

.history__item--active {
    border-color: var(--accent-glow);
    background-color: var(--accent-soft);
}

.history__title {
    color: var(--text-0);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.history__provider {
    color: var(--accent-2);
    background-color: var(--accent-soft);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    -unity-font-style: bold;
    flex-shrink: 0;
    max-width: 48%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.history__meta {
    color: var(--text-3);
    font-size: 12px;
}

/* Session delete button */
.history__delete-btn {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    padding: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: var(--text-3);
    font-size: 14px;
    display: none;
    flex-shrink: 0;
    margin-left: auto;
    align-items: center;
    justify-content: center;
}

.history__item:hover .history__delete-btn {
    display: flex;
}

.history__delete-btn:hover,
.history__delete-btn--confirm {
    background-color: rgba(239, 100, 100, 0.15);
    border-color: rgba(239, 100, 100, 0.30);
    color: #ef6464;
}

/* ============== Nav close button ============== */

.nav__item--close {
    margin-top: 2px;
    opacity: 0.55;
}

.nav__item--close:hover {
    opacity: 1.0;
}

/* ============== Quit confirmation overlay ============== */

.quit-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.quit-dialog {
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 14px;
    padding: 24px 28px;
    min-width: 300px;
    max-width: 380px;
}

.quit-dialog__title {
    font-size: 16px;
    color: var(--text-0);
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-SemiBold.ttf");
    margin-bottom: 8px;
}

.quit-dialog__body {
    font-size: 13px;
    color: var(--text-3);
    margin-bottom: 22px;
    white-space: normal;
}

.quit-dialog__actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.quit-dialog__actions > Button {
    margin-left: 8px;
}


/* ============================================================
   Platform & Mobile adaptations (Android support - PL-04)
   .app gets .platform-mobile / .platform-android from PlatformLayoutAdapter
   Safe Area padding is set in C# on the root
   ============================================================ */

.app.platform-mobile {
    /* Base mobile adjustments */
}

.app.platform-mobile .rail {
    width: 180px; /* more compact sidebar */
    padding: 10px 8px;
}

.app.platform-mobile .nav__item {
    height: 44px; /* improved touch targets */
    padding: 6px 8px;
}

.app.platform-mobile .brand__name {
    font-size: 13px;
}

.app.platform-android .composer {
    /* extra breathing room for system navigation */
    padding-bottom: 12px;
}

.app.platform-mobile .composer__send,
.app.platform-mobile .iconbtn {
    min-width: 44px;
    min-height: 44px; /* larger tap areas */
}


/* ============================================================
   Extended mobile / Android adaptations (full readiness)
   Touch targets, panels, fonts, composer, history for small screens
*/
.app.platform-mobile {
    /* General touch-friendly */
    --touch-target: 44px;
}

.app.platform-mobile .nav__item,
.app.platform-mobile .iconbtn,
.app.platform-mobile .composer__send {
    min-width: 44px;
    min-height: 44px;
}

.app.platform-mobile .rail {
    width: 160px;
    padding: 8px 6px;
}

.app.platform-mobile .brand__name {
    font-size: 12px;
}

.app.platform-mobile .history__item {
    min-height: 42px;
    font-size: 13px;
}

.app.platform-android .app__content,
.app.platform-android .main-content {
    /* extra bottom space if needed */
    padding-bottom: 8px;
}

.app.platform-mobile .settings-panel,
.app.platform-mobile .avatar-panel {
    /* make side panels behave better on portrait */
    max-width: 85%;
}


/* Additional mobile/Android polish for full readiness */
.app.platform-mobile .settings-panel {
    font-size: 14px;
}

.app.platform-mobile .history-list {
    font-size: 13px;
}

.app.platform-android .topbar {
    padding-top: 8px;
}

/* Full mobile readiness - additional panels and components */
.app.platform-mobile .avatar-panel {
    max-height: 45%;
}

.app.platform-mobile .settings-content {
    padding: 8px;
    font-size: 13px;
}

.app.platform-android .main-content {
    padding-bottom: 24px; /* extra for gesture navigation */
}

.app.platform-mobile .panel-header {
    min-height: 44px;
}


/* ============================================================
   Android / Mobile enhancements (PL-04 continued)
   - Better touch targets
   - Composer & keyboard handling prep
   - Gesture nav / notch compensation
   ============================================================ */

.app.platform-mobile .iconbtn,
.app.platform-mobile .composer__send,
.app.platform-mobile .nav__item {
    min-height: 44px;
    min-width: 44px;
}

.app.platform-android .composer {
    padding-bottom: 24px;
    padding-top: 8px;
}

.app.platform-android .composer__input {
    min-height: 42px;
    font-size: 15px;
}

/* Voice / mic button should be very tappable on Android */
.app.platform-android .iconbtn--mic,
.app.platform-android .icon--mic {
    min-width: 48px;
    min-height: 48px;
    background-size: 24px 24px;
}

/* Extra bottom space for Android navigation bar / gesture area */
.app.platform-android .app__content {
    padding-bottom: 32px;
}

/* Smaller rail on very small Android screens (when rail is shown) */
.app.platform-android .rail {
    width: 200px;
}

/* History and settings list items - better tap area */
.app.platform-mobile .history__item,
.app.platform-mobile .settings-item {
    min-height: 48px;
    padding: 10px 12px;
}

/* ============================================================
   iOS-specific adaptations (IOS-06)
   Notch, home indicator, safe area tweaks beyond .platform-mobile
   ============================================================ */
.app.platform-ios {
    /* iOS tends to have stronger safe area; extra breathing if needed */
}

.app.platform-ios .composer {
    /* extra padding for home indicator / gesture bar */
    padding-bottom: 22px;
}

.app.platform-ios .nav__item {
    /* slightly different touch feel on iOS */
    height: 46px;
}

/* ============================================================
   Desktop responsive — borderless resizable window (min 760×560).
   Breakpoint classes app--compact / app--narrow are toggled from C#
   (LayoutController) on root width. The avatar (right) panel auto-hide
   is handled in C# (display), not here, to avoid clashing with the
   inline width set by PanelResizeHandler.
   ============================================================ */

/* Let shell areas shrink below their content width instead of overflowing. */
.main,
.content-host,
.composer {
    min-width: 0;
}

/* --- Compact (<1000px): declutter the topbar, free horizontal space --- */
.app--compact .topbar {
    padding-left: 14px;
    padding-right: 14px;
}

.app--compact .topbar__right > Button {
    margin-left: 6px;
}

.app--compact .topbar__model-picker {
    max-width: 150px;
    margin-left: 8px;
}

/* Ghost text buttons (Резюме / Export) drop out first — they overlap at
   narrow widths and stay reachable when the window is widened. */
.app--compact .topbar__right > .btn--ghost {
    display: none;
}

/* --- Narrow (<820px): strip the topbar subtitle + separator --- */
.app--narrow .topbar__subtitle,
.app--narrow .topbar__sep {
    display: none;
}

.app--narrow .topbar {
    padding-left: 10px;
    padding-right: 10px;
}

/* ============================================================
   Rail density — компактнее кнопки сессий и плитки сессий.
   ============================================================ */
.rail__sessions-head .iconbtn,
.history__searchbar-clear {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    padding: 5px;
}

/* Плитки сессий в рейле: одна строка-заголовок, плотный ритм (как в Claude Code). */
.rail__sessions-list .history__item {
    padding: 1px 6px;
    margin-bottom: 0;
    border-radius: 5px;
}

.rail__sessions-list .history__row {
    margin-bottom: 0;
    min-height: 18px;
}

.rail__sessions-list .history__title {
    font-size: 11px;
    -unity-font-style: normal;
    color: var(--text-2);
}

.rail__sessions-list .history__delete-btn {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    font-size: 12px;
    border-radius: 5px;
}

.rail__sessions-list .history__item:hover .history__title,
.rail__sessions-list .history__item--active .history__title {
    color: var(--text-0);
}

/* Группировку («Недавние»/по датам) в рейле убираем — просто список плиток. */
.rail__sessions-list .history__group {
    display: none;
}

/* Чип провайдера в плитках рейла — мусор, убираем (в панели Истории остаётся). */
.rail__sessions-list .history__item .history__provider {
    display: none;
}

/* Счётчик сообщений скрываем — он дублирует инфу и раздувает плитку по высоте.
   Селектор именно внутри плитки, чтобы не задеть пустой статус «нет сессий». */
.rail__sessions-list .history__item .history__meta {
    display: none;
}

/* ============================================================
   MOBILE FIX — hide rail, full-width content
   ============================================================ */
.app.platform-mobile .rail {
    display: none;
}
.app.platform-mobile .rail-resize-handle {
    display: none;
}
.app.platform-mobile .app__content {
    margin-left: 0;
    width: 100%;
    flex-grow: 1;
}

/* Mobile-only visibility */
.mobile-only { display: none; }
.app.platform-mobile .mobile-only { display: flex; }
