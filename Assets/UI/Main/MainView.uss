/* ============ Calm Productivity — Avatar-first layout ============ */

.app-root {
    flex-grow: 1;
    background-color: rgb(16, 17, 21);
    padding: 16px;
}

.content-host {
    flex-grow: 1;
    background-color: rgb(22, 24, 29);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(40, 44, 52);
    padding: 16px;
}

/* ---- panels ---- */
.panel {
    display: none;
    flex-grow: 1;
}
.panel--active {
    display: flex;
}
.panel-title {
    font-size: 22px;
    color: rgb(230, 232, 236);
    -unity-font-style: bold;
    margin-bottom: 6px;
}
.panel-subtitle {
    font-size: 14px;
    color: rgb(130, 138, 150);
}

/* ---- top bar ---- */
.topbar {
    flex-direction: row;
    align-items: center;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(34, 37, 44);
    margin-bottom: 12px;
}
.topbar__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 232, 236);
    margin-right: 10px;
}
.topbar__model {
    font-size: 12px;
    color: rgb(120, 128, 140);
    padding: 3px 8px;
    background-color: rgb(28, 30, 36);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(40, 44, 52);
}
.topbar__spacer {
    flex-grow: 1;
}
.icon-btn {
    height: 30px;
    padding: 0 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(40, 44, 52);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(180, 188, 200);
    font-size: 12px;
}
.icon-btn:hover {
    background-color: rgb(28, 30, 36);
    color: rgb(220, 224, 232);
}

/* ---- stage (avatar hero) ---- */
.stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    overflow: hidden;
}
.stage__glow {
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 190px;
    background-color: rgba(90, 120, 240, 0.18);
}
.stage__avatar {
    width: 260px;
    height: 260px;
    border-radius: 130px;
    background-color: rgb(30, 33, 40);
    border-width: 1px;
    border-color: rgb(50, 55, 64);
    align-items: center;
    justify-content: center;
}
.stage__placeholder {
    font-size: 14px;
    color: rgb(90, 98, 110);
    -unity-font-style: italic;
}

/* ---- subtitle (last assistant message) ---- */
.subtitle {
    min-height: 56px;
    background-color: rgb(28, 30, 36);
    border-width: 1px;
    border-color: rgb(40, 44, 52);
    border-radius: 10px;
    border-left-width: 3px;
    border-left-color: rgb(90, 120, 240);
    padding: 12px 14px;
    margin-bottom: 12px;
}
.subtitle__text {
    font-size: 15px;
    color: rgb(220, 224, 232);
    white-space: normal;
}

/* ---- composer ---- */
.composer {
    flex-direction: row;
    align-items: center;
}
.composer__input {
    flex-grow: 1;
    margin-right: 10px;
    height: 44px;
    border-radius: 10px;
}
.composer__input > .unity-text-field__input {
    background-color: rgb(28, 30, 36);
    border-color: rgb(45, 49, 58);
    border-width: 1px;
    border-radius: 10px;
    color: rgb(230, 232, 236);
    padding: 0 14px;
    font-size: 14px;
}

/* ---- buttons ---- */
.btn {
    height: 44px;
    padding: 0 20px;
    border-radius: 10px;
    border-width: 1px;
    font-size: 14px;
    -unity-font-style: bold;
}
.btn--primary {
    background-color: rgb(90, 120, 240);
    color: rgb(245, 247, 255);
    border-color: rgb(90, 120, 240);
}
.btn--primary:hover {
    background-color: rgb(110, 138, 250);
}

/* ---- tab bar ---- */
.tab-bar {
    margin-top: 12px;
    height: 48px;
    flex-direction: row;
}
.tab-btn {
    flex-grow: 1;
    margin-right: 6px;
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(40, 44, 52);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(180, 188, 200);
    font-size: 14px;
}
.tab-btn:hover {
    background-color: rgb(28, 30, 36);
    color: rgb(220, 224, 232);
}
.tab-btn--last {
    margin-right: 0;
}
.tab-btn--active {
    background-color: rgb(28, 30, 36);
    color: rgb(230, 232, 236);
    border-color: rgb(90, 120, 240);
}
