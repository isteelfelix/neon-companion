/* ============================================================
   MainView — app shell: rail, topbar, content host
   Page-specific styles live in each view's own .uss file.
   ============================================================ */

.app {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--bg-0);
    color: var(--text-1);
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/Fonts/Geist/Geist-Regular.ttf");
}

.app__atmo {
    position: absolute;
    left: 232px;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Avatars/atmo.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.is-hidden {
    display: none;
}

/* ============== Icons ============== */

.icon {
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-2);
}

.icon--active,
.nav__item--active .nav__icon {
    -unity-background-image-tint-color: var(--accent);
}

.icon--arrow      { background-image: url("project://database/Assets/UI/Icons/arrow.svg"); }
.icon--attach     { background-image: url("project://database/Assets/UI/Icons/attach.svg"); }
.icon--bolt       { background-image: url("project://database/Assets/UI/Icons/bolt.svg"); }
.icon--chat       { background-image: url("project://database/Assets/UI/Icons/chat.svg"); }
.icon--check      { background-image: url("project://database/Assets/UI/Icons/check.svg"); }
.icon--copy       { background-image: url("project://database/Assets/UI/Icons/copy.svg"); }
.icon--dots       { background-image: url("project://database/Assets/UI/Icons/dots.svg"); }
.icon--headphones { background-image: url("project://database/Assets/UI/Icons/headphones.svg"); }
.icon--history    { background-image: url("project://database/Assets/UI/Icons/history.svg"); }
.icon--palette    { background-image: url("project://database/Assets/UI/Icons/palette.svg"); }
.icon--plus       { background-image: url("project://database/Assets/UI/Icons/plus.svg"); }
.icon--refresh    { background-image: url("project://database/Assets/UI/Icons/refresh.svg"); }
.icon--search     { background-image: url("project://database/Assets/UI/Icons/search.svg"); }
.icon--send       { background-image: url("project://database/Assets/UI/Icons/send.svg"); }
.icon--settings   { background-image: url("project://database/Assets/UI/Icons/settings.svg"); }
.icon--sparkle    { background-image: url("project://database/Assets/UI/Icons/sparkle.svg"); }
.icon--upload     { background-image: url("project://database/Assets/UI/Icons/upload.svg"); }
.icon--user       { background-image: url("project://database/Assets/UI/Icons/user.svg"); }

/* ============== Rail ============== */

.rail {
    width: 232px;
    flex-shrink: 0;
    background-color: var(--bg-1);
    border-right-width: 1px;
    border-right-color: var(--line-1);
    flex-direction: column;
    padding: 14px 12px;
}

.rail__brand {
    height: 47px;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    margin-bottom: 10px;
}

.brand__mark {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background-color: var(--accent);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.brand__mark-text {
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
}

.brand__name {
    color: var(--text-0);
    font-size: 15px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.brand__tag {
    color: var(--text-3);
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.nav__group {
    padding: 16px 10px 6px;
    color: var(--text-4);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
    -unity-font-style: bold;
}

.nav__item {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0);
    /* Button reset */
    -unity-font-style: normal;
}

.nav__item:hover {
    background-color: var(--bg-2);
}

.nav__item--active {
    background-color: var(--bg-3);
    border-color: var(--line-2);
}

.nav__icon {
    width: 16px;
    height: 16px;
    margin-right: 10px;
}

.nav__label {
    font-size: 13px;
    color: var(--text-2);
    flex-grow: 1;
}

.nav__item:hover .nav__label {
    color: var(--text-1);
}

.nav__item--active .nav__label {
    color: var(--text-0);
}

.nav__count {
    color: var(--text-3);
    font-size: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.rail__spacer {
    display: none;
}

.rail__footer {
    height: 45px;
    border-top-width: 1px;
    border-top-color: var(--line-1);
    padding-top: 10px;
    flex-direction: row;
    align-items: center;
}

.dot--status {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--ok);
    margin-right: 10px;
}

.rail__footer-text {
    flex-direction: column;
}

.rail__footer-provider {
    font-size: 12px;
    color: var(--text-1);
}

.rail__footer-model {
    font-size: 10px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ============== Main shell ============== */

.main {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.topbar {
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 22px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line-1);
    background-color: var(--bg-1);
}

.topbar__left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.topbar__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-0);
}

.topbar__subtitle {
    font-size: 11px;
    color: var(--text-3);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.topbar__sep {
    width: 1px;
    height: 18px;
    background-color: var(--line-2);
    margin-left: 12px;
    margin-right: 12px;
}

.topbar__right {
    flex-direction: row;
    align-items: center;
}

.topbar__right > Button {
    margin-left: 8px;
}

.iconbtn {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    padding: 7px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
}

.iconbtn:hover {
    background-color: var(--bg-3);
    -unity-background-image-tint-color: var(--text-0);
}

/* ============== Content host + panels ============== */

.content-host {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.panel {
    display: none;
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.panel--active {
    display: flex;
}

/* ============== Shared page layout ============== */

.page {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.page__head {
    min-height: 64px;
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 28px;
}

.page__head-copy {
    flex-grow: 1;
    flex-direction: column;
}

.page__title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text-0);
    margin-bottom: 4px;
}

.page__subtitle {
    font-size: 13px;
    color: var(--text-3);
    white-space: normal;
}

.page__actions {
    flex-direction: row;
    align-items: center;
}

.page__actions > Button {
    margin-left: 8px;
}

/* ---- Rail sessions ---- */

.rail__divider {
    height: 1px;
    background-color: var(--line-1);
    margin: 8px 0 4px;
    flex-shrink: 0;
}

.rail__sessions-head {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px 2px;
    flex-shrink: 0;
}

.rail__sessions-label {
    flex-grow: 1;
    font-size: 10px;
    color: var(--text-4);
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.rail__sessions-list {
    flex-grow: 1;
    min-height: 0;
    padding: 2px 4px;
}

/* ---- Placeholder page ---- */

.placeholder-page {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 28px 36px 36px;
}

/* ---- History panel ---- */

.history-panel__state {
    color: var(--text-3);
    font-size: 13px;
    margin-bottom: 10px;
}

.history-panel__state--error {
    color: #ffb4b4;
}

.history-panel__list {
    flex-grow: 1;
    min-height: 0;
    padding: 2px 4px;
}

.history__searchbar {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--surface-1) 80%, transparent);
    margin-bottom: 12px;
    padding: 0 4px;
}

.history__searchbar-icon {
    width: 14px;
    height: 14px;
    opacity: 0.65;
    margin-left: 8px;
}

.history__searchbar-input {
    flex-grow: 1;
    margin: 0 4px;
}

.history__searchbar-input > .unity-text-field__input,
.history__searchbar-input > .unity-base-text-field__input {
    border-width: 0;
    background-color: transparent;
    color: var(--text-1);
    font-size: 13px;
}

.history__searchbar-clear {
    width: 26px;
    height: 26px;
}

.history__group {
    color: var(--text-4);
    font-size: 10px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
    margin: 8px 8px 4px;
}

.history__item {
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    padding: 8px 10px;
    margin-bottom: 4px;
}

.history__item:hover {
    background-color: color-mix(in srgb, var(--surface-2) 70%, transparent);
}

.history__item--active {
    border-color: color-mix(in srgb, var(--accent-0) 40%, transparent);
    background-color: color-mix(in srgb, var(--accent-0) 12%, transparent);
}

.history__title {
    color: var(--text-0);
    font-size: 13px;
    -unity-font-style: semi-bold;
    margin-bottom: 2px;
}

.history__meta {
    color: var(--text-3);
    font-size: 12px;
}
