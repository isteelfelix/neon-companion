.preview-root {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgb(20, 20, 24);
    padding: 16px;
}

.card {
    width: 360px;
    height: 220px;
    margin: 8px;
    padding: 20px;
    border-radius: 14px;
    justify-content: space-between;
}

.card-title {
    font-size: 20px;
    -unity-font-style: bold;
}

.card-sub {
    font-size: 13px;
    margin-top: 4px;
}

.row {
    flex-direction: row;
    margin-top: 12px;
}

.btn {
    height: 40px;
    padding-left: 18px;
    padding-right: 18px;
    margin-right: 10px;
    border-radius: 8px;
    border-width: 1px;
    font-size: 14px;
    -unity-font-style: bold;
}

/* ============ A. Cyberpunk Neon ============ */
.card--neon {
    background-color: rgb(10, 6, 18);
    border-width: 1px;
    border-color: rgb(0, 240, 255);
}
.card-title--neon {
    color: rgb(0, 240, 255);
    letter-spacing: 4px;
}
.card-sub--neon {
    color: rgb(255, 42, 109);
    -unity-font-style: italic;
}
.btn--neon-primary {
    background-color: rgb(0, 240, 255);
    color: rgb(10, 6, 18);
    border-color: rgb(0, 240, 255);
    letter-spacing: 2px;
}
.btn--neon-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 42, 109);
    border-color: rgb(255, 42, 109);
    letter-spacing: 2px;
}

/* ============ B. Glass / Aurora ============ */
.card--aurora {
    background-color: rgb(28, 22, 56);
    border-width: 1px;
    border-color: rgba(150, 120, 255, 0.35);
}
.card-title--aurora {
    color: rgb(220, 210, 255);
}
.card-sub--aurora {
    color: rgb(160, 170, 220);
}
.btn--aurora-primary {
    background-color: rgb(120, 90, 220);
    color: rgb(245, 240, 255);
    border-color: rgba(180, 160, 255, 0.6);
}
.btn--aurora-ghost {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(200, 200, 230);
    border-color: rgba(255, 255, 255, 0.15);
}

/* ============ C. VN / Galgame ============ */
.card--vn {
    background-color: rgb(248, 240, 230);
    border-width: 2px;
    border-color: rgb(180, 90, 110);
}
.card-title--vn {
    color: rgb(120, 50, 70);
}
.card-sub--vn {
    color: rgb(80, 60, 60);
    font-size: 15px;
}
.btn--vn-primary {
    background-color: rgb(220, 110, 130);
    color: rgb(255, 250, 245);
    border-color: rgb(180, 90, 110);
}
.btn--vn-ghost {
    background-color: rgb(255, 250, 245);
    color: rgb(120, 50, 70);
    border-color: rgb(180, 90, 110);
}

/* ============ D. Calm Productivity ============ */
.card--calm {
    background-color: rgb(22, 24, 29);
    border-width: 1px;
    border-color: rgb(40, 44, 52);
}
.card-title--calm {
    color: rgb(230, 232, 236);
}
.card-sub--calm {
    color: rgb(130, 138, 150);
}
.btn--calm-primary {
    background-color: rgb(90, 120, 240);
    color: rgb(245, 247, 255);
    border-color: rgb(90, 120, 240);
}
.btn--calm-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(180, 188, 200);
    border-color: rgb(50, 55, 64);
}
