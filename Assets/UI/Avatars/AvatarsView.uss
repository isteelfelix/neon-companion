/* ============================================================
   AvatarsView — gallery + preview card
   ============================================================ */

.avatars-page {
    flex-grow: 1;
    flex-direction: column;
    padding: 28px 36px 36px;
    overflow: hidden;
}

/* ---- Filter row ---- */

.filterrow {
    min-height: 30px;
    flex-direction: row;
    margin-bottom: 18px;
}

.filterchip {
    height: 28px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    border-radius: 999px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    color: var(--text-2);
    margin-right: 6px;
    /* Button reset */
    -unity-font-style: normal;
}

.filterchip Label {
    font-size: 12px;
}

.filterchip--active {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-text);
}

.filterchip__count {
    font-size: 10px;
    color: var(--text-3);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    padding: 1px 5px;
    margin-left: 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ---- Split layout ---- */

.avatar-split {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* ---- Gallery grid ---- */

.gallery {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    margin-right: 22px;
}

/* ============== Avatar tile ============== */

.avtile {
    width: 23%;
    height: 168px;
    min-width: 130px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line-1);
    background-color: var(--bg-1);
    margin-right: 14px;
    margin-bottom: 14px;
    padding: 12px;
    justify-content: flex-end;
    overflow: hidden;
    position: relative;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.avtile:hover {
    scale: 1.02;
}

.avtile--selected {
    border-color: var(--accent);
    border-width: 2px;
}

/* ---- Tile color variants ---- */
.avtile--neon   { background-color: #4f45d8; }
.avtile--aurora { background-color: #3faec0; }
.avtile--ember  { background-color: #c84c2c; }
.avtile--glass  { background-color: #2d3240; }
.avtile--flora  { background-color: #32835c; }
.avtile--mono   { background-color: #9aa2b3; }
.avtile--cobalt { background-color: #304bd0; }
.avtile--rose   { background-color: #bf507c; }

/* ---- Vignette overlay (hidden — USS has no gradient support) ---- */

.avtile__vignette {
    display: none;
}

/* ---- Tile name ---- */

.avtile__name {
    position: absolute;
    left: 10px;
    bottom: 9px;
    color: rgba(255, 255, 255, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.38);
    border-radius: 6px;
    padding: 2px 7px;
}

/* ---- Selection badge ---- */

.avtile__badge {
    display: none;
    position: absolute;
    top: 10px;
    right: 10px;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background-color: var(--accent);
    align-items: center;
    justify-content: center;
}

.avtile--selected .avtile__badge {
    display: flex;
}

.avtile__badge .icon {
    width: 12px;
    height: 12px;
    -unity-background-image-tint-color: white;
}

/* ---- Upload tile ---- */

.avtile--upload {
    background-color: var(--bg-1);
    padding: 6px;
}

.avtile__upload {
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    color: var(--text-3);
}

.avtile__upload .icon {
    width: 22px;
    height: 22px;
    margin-bottom: 8px;
}

.avtile__upload Label {
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ============== Preview card ============== */

.previewcard {
    width: 320px;
    flex-shrink: 0;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 14px;
    padding: 20px;
    flex-direction: column;
}

.preview-hero {
    height: 280px;
    border-radius: 10px;
    background-color: #4f45d8;
    -unity-background-scale-mode: scale-and-crop;
    margin-bottom: 16px;
    justify-content: flex-end;
    padding: 14px;
}

.preview-hero__title {
    color: var(--text-0);
    font-size: 18px;
    -unity-font-style: bold;
}

.preview-hero__tag {
    color: var(--text-2);
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.preview-emoji-overlay {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 28px;
}

.preview-frame--none { }
.preview-frame--neon { border-width: 2px; border-color: #7c7aed; }
.preview-frame--gold { border-width: 3px; border-color: #f4c34f; }
.preview-frame--holographic { border-width: 3px; border-color: #7ce7ff; }

.preview-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.preview-row Label {
    font-size: 12px;
    color: var(--text-3);
}

.preview-row__value {
    color: var(--text-1);
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.preview-persona-label {
    margin-top: 10px;
}

.persona-state {
    margin-top: 10px;
    margin-bottom: 2px;
}

.persona-state__badge {
    align-self: flex-start;
    font-size: 10px;
    color: var(--accent-text);
    background-color: var(--accent-soft);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 999px;
    padding: 2px 8px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Medium.ttf");
}

.persona-state__help {
    margin-top: 6px;
    color: var(--text-3);
    font-size: 11px;
}

.persona-box {
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 12px;
    color: var(--text-2);
    font-size: 11px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.preview-actions {
    flex-direction: row;
    margin-top: 14px;
}

.preview-actions > Button {
    flex-grow: 1;
    margin-right: 8px;
}

.preview-actions > Button.is-last {
    margin-right: 0;
}

.persona-editor {
    flex-direction: column;
    margin-top: 10px;
}

.persona-edit-field {
    height: 96px;
    margin-bottom: 10px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
}

.persona-edit-field > #unity-text-input {
    background-color: transparent;
    border-width: 0;
    padding: 12px;
    color: var(--text-2);
    font-size: 11px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.customize {
    margin-top: 12px;
    color: var(--text-2);
}

.customize__row {
    margin-top: 8px;
}

.customize__hex {
    margin-top: 4px;
    height: 28px;
}

.customize__swatches {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.customize__swatch {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 999px;
    border-width: 1px;
    border-color: var(--line-2);
}

.customize__emoji-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.customize__emoji-btn {
    width: 34px;
    height: 30px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: var(--bg-2);
}

.customize__emoji-btn.is-active {
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.customize__frame-segment {
    flex-direction: row;
    margin-top: 4px;
}

.customize__frame-btn {
    flex-grow: 1;
    height: 30px;
    margin-right: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: var(--bg-2);
}

.customize__frame-btn:last-child {
    margin-right: 0;
}

.customize__frame-btn.is-active {
    border-color: var(--accent);
    background-color: var(--accent-soft);
    color: var(--accent-text);
}
