/* ============================================================
   AvatarsView — gallery + preview card
   ============================================================ */

.avatars-page {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px 20px 20px;
    overflow: hidden;
}

/* Compact header: the subtitle repeats what the category tabs already say and
   ate a whole row (~30% of the fold on a phone). Drop it and tighten the head
   on every form factor — the title + actions are enough. */
.avatars-page .page__subtitle {
    display: none;
}

.avatars-page .page__head {
    margin-bottom: 10px;
}

/* ---- View-mode switcher ---- */

.viewmode-row {
    flex-direction: row;
    margin-bottom: 16px;
    background-color: var(--bg-2);
    border-radius: 12px;
    padding: 4px;
    align-self: flex-start;
    border-width: 1px;
    border-color: var(--line-2);
}

.viewmode-btn {
    min-width: 104px;
    height: 32px;
    padding: 0 16px;
    border-radius: 8px;
    border-width: 0;
    background-color: transparent;
    color: var(--text-3);
    -unity-font-style: normal;
    font-size: 12px;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.viewmode-btn Label {
    font-size: 12px;
}

.viewmode-btn--active {
    background-color: var(--bg-0);
    color: var(--text-0);
    border-width: 1px;
    border-color: var(--line-2);
}

/* ---- Gallery container ---- */

.gallery-container {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

/* ---- Empty gallery hint ---- */

.gallery-empty-hint {
    color: var(--text-3);
    font-size: 12px;
    margin: 24px 0 0 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ---- Capability facts ---- */

.capability-card {
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 10px;
}

.capability-card__title {
    color: var(--text-0);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.capability-card__fact,
.capability-card__evidence {
    color: var(--text-2);
    font-size: 11px;
    margin-bottom: 4px;
    white-space: normal;
}

.capability-card__evidence {
    color: var(--text-3);
    margin-top: 3px;
}

.capability-card__diagnostic {
    color: #e5a955;
    font-size: 11px;
    margin-top: 5px;
    white-space: normal;
}

/* ---- Avatar import dialog ---- */

.avatar-import-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.avatar-import-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 5, 10, 0.82);
}

.avatar-import-dialog {
    width: 720px;
    max-width: 92%;
    max-height: 92%;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 16px;
    padding: 18px;
}

.avatar-import-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.avatar-import-title {
    color: var(--text-0);
    font-size: 18px;
    -unity-font-style: bold;
}

.avatar-import-subtitle,
.avatar-import-help {
    color: var(--text-3);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

.avatar-import-close {
    width: 30px;
    height: 30px;
    border-width: 0;
    background-color: transparent;
    color: var(--text-2);
    font-size: 20px;
}

.avatar-import-types {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.avatar-import-type {
    height: 32px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding: 0 13px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 8px;
    color: var(--text-2);
}

.avatar-import-type--active {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-text);
}

.avatar-import-source-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    margin-bottom: 12px;
}

.avatar-import-source {
    flex-grow: 1;
    color: var(--text-2);
    font-size: 11px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 8px;
    padding: 8px 10px;
    margin-right: 8px;
    white-space: normal;
}

.avatar-import-preview-row {
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 14px;
}

.avatar-import-preview-box {
    width: 210px;
    height: 210px;
    flex-shrink: 0;
    background-color: var(--bg-0);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-right: 12px;
}

.avatar-import-preview-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.avatar-import-preview-placeholder {
    color: var(--text-3);
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 12px;
}

.avatar-import-capabilities {
    flex-grow: 1;
}

.avatar-import-mapping {
    margin-bottom: 12px;
}

.avatar-import-mapping-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.avatar-import-clip {
    width: 48%;
    margin-right: 2%;
    margin-bottom: 6px;
}

.avatar-import-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.ff-phone .avatar-import-dialog {
    width: 94%;
    max-width: 94%;
    max-height: 94%;
}

.ff-phone .avatar-import-preview-row {
    flex-direction: column;
}

.ff-phone .avatar-import-preview-box {
    width: 100%;
    height: 180px;
    margin-right: 0;
    margin-bottom: 10px;
}

.ff-phone .avatar-import-clip {
    width: 100%;
    margin-right: 0;
}

/* ---- Animated tile badge ---- */

.avtile__anim-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: rgba(124, 122, 237, 0.85);
    border-radius: 5px;
    padding: 2px 6px;
}

.avtile__anim-badge Label {
    font-size: 9px;
    color: white;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Medium.ttf");
    letter-spacing: 0.5px;
}

/* ---- Filter row ---- */

.filterrow {
    min-height: 24px;
    flex-direction: row;
    margin-bottom: 10px;
}

.filterchip {
    height: 24px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    border-radius: 8px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    color: var(--text-2);
    margin-right: 6px;
    /* Button reset */
    -unity-font-style: normal;
}

.filterchip Label {
    font-size: 12px;
}

.filterchip--active {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-text);
}

.filterchip__count {
    font-size: 10px;
    color: var(--text-3);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    padding: 1px 5px;
    margin-left: 6px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ---- Split layout ---- */

.avatar-split {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* ---- Gallery grid ---- */

.gallery {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    margin-right: 20px;
}

.avtile__model-mark {
    position: absolute;
    left: 0;
    right: 0;
    top: 44px;
    color: rgba(255, 255, 255, 0.18);
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-SemiBold.ttf");
}

/* ============== Avatar tile ============== */

.avtile {
    width: 220px;
    height: 164px;
    min-width: 180px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line-1);
    background-color: var(--bg-1);
    margin-right: 14px;
    margin-bottom: 14px;
    padding: 12px;
    justify-content: flex-end;
    overflow: hidden;
    position: relative;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.avtile:hover {
    scale: 1.02 1.02;
}

.avtile--selected {
    border-color: var(--accent);
    border-width: 2px;
}

/* ---- Tile color variants ---- */
.avtile--neon   { background-color: #4f45d8; }
.avtile--vrm    { background-color: #171923; }
.avtile--yorha-2b { background-color: #24242b; }
.avtile--aurora { background-color: #3faec0; }
.avtile--ember  { background-color: #c84c2c; }
.avtile--glass  { background-color: #2d3240; }
.avtile--flora  { background-color: #32835c; }
.avtile--mono   { background-color: #9aa2b3; }
.avtile--cobalt { background-color: #304bd0; }
.avtile--rose   { background-color: #bf507c; }

/* ---- Vignette overlay (hidden — USS has no gradient support) ---- */

.avtile__vignette {
    display: none;
}

/* ---- Tile name ---- */

.avtile__name {
    position: absolute;
    left: 10px;
    bottom: 9px;
    color: rgba(255, 255, 255, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.38);
    border-radius: 6px;
    padding: 2px 7px;
}

/* ---- Selection badge ---- */

.avtile__badge {
    display: none;
    position: absolute;
    top: 10px;
    right: 10px;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background-color: var(--accent);
    align-items: center;
    justify-content: center;
}

.avtile--selected .avtile__badge {
    display: flex;
}

.avtile__badge .icon {
    width: 12px;
    height: 12px;
    -unity-background-image-tint-color: white;
}

/* ============================================================
   Узкое окно: кнопки шапки переносятся под текст, фильтры — в несколько
   рядов (иначе «Открыть папку/Загрузить» и чипы фильтров уезжали за край).
   ============================================================ */
.app--compact .avatars-page {
    padding: 12px 14px 14px;
}

.app--compact .page__head {
    flex-wrap: wrap;
}

.app--compact .page__actions {
    margin-top: 10px;
}

.app--compact .filterrow {
    flex-wrap: wrap;
    height: auto;
}

.app--compact .filterchip {
    margin-bottom: 6px;
}

/* ---- Upload tile ---- */

.avtile--upload {
    background-color: var(--bg-1);
    padding: 6px;
}

.avtile__upload {
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    color: var(--text-3);
}

.avtile__upload .icon {
    width: 22px;
    height: 22px;
    margin-bottom: 8px;
}

.avtile__upload Label {
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

/* ============== Preview card ============== */

.previewcard {
    width: 360px;
    min-width: 340px;
    flex-shrink: 0;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: 14px;
    padding: 14px 12px 14px 14px;
    flex-direction: column;
    min-height: 0;
}

/* ============================================================
   Phone / narrow window. `.ff-phone` also applies to a desktop window resized
   below the phone breakpoint, so these rules cover both. The section becomes
   single-pane: the tile list fills the width, and tapping a tile swaps it for
   the settings panel (detail mode, toggled by C# via `avatars-page--detail`).
   Before this, the desktop list+settings split was crammed side by side and
   the category row overflowed off the right edge (VRM was unreachable).
   ============================================================ */
.ff-phone .avatars-page {
    padding-left: 14px;
    padding-right: 14px;
}

/* Category switcher wraps into a grid that stretches to the window instead of
   running off-screen. flex-basis 40% + grow ⇒ two equal columns (2×2). */
.ff-phone .viewmode-row {
    align-self: stretch;
    flex-wrap: wrap;
}

.ff-phone .viewmode-btn {
    flex-grow: 1;
    flex-basis: 40%;
    min-width: 0;
    padding: 0 10px;
}

.ff-phone .avatar-split {
    flex-direction: column;
}

.ff-phone .gallery-container {
    flex-grow: 1;
}

.ff-phone .gallery {
    flex-wrap: wrap;
    margin-right: 0;
}

/* List mode: settings panel hidden. */
.ff-phone .previewcard {
    display: none;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    margin-top: 0;
}

/* Detail mode: everything but the settings panel collapses, giving a clean
   full-screen editor with its own back button. */
.ff-phone .avatars-page--detail .page__head,
.ff-phone .avatars-page--detail .viewmode-row,
.ff-phone .avatars-page--detail .filterrow,
.ff-phone .avatars-page--detail .gallery-container {
    display: none;
}

.ff-phone .avatars-page--detail .previewcard {
    display: flex;
    flex-grow: 1;
}

/* Back-to-list button: phone detail mode only. */
.preview-back {
    display: none;
    align-self: flex-start;
    margin-bottom: 10px;
}

.ff-phone .preview-back {
    display: flex;
}

.preview-scroll {
    flex-grow: 1;
    min-height: 0;
}

.preview-scroll > .unity-scroll-view__content-container {
    padding-right: 4px;
}

.preview-hero {
    height: 184px;
    border-radius: 10px;
    background-color: #4f45d8;
    -unity-background-scale-mode: scale-and-crop;
    margin-bottom: 6px;
    justify-content: flex-end;
    padding: 14px;
}

.preview-hero__title {
    color: var(--text-0);
    font-size: 18px;
    -unity-font-style: bold;
}

.preview-hero__tag {
    color: var(--text-2);
    font-size: 11px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.preview-emoji-overlay {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 28px;
}

.preview-persona-label {
    margin-top: 8px;
}

.persona-state {
    margin-top: 2px;
    margin-bottom: 2px;
}

.persona-state__badge {
    align-self: flex-start;
    font-size: 10px;
    color: var(--accent-text);
    background-color: var(--accent-soft);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 6px;
    padding: 2px 8px;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Medium.ttf");
}

.persona-state__help {
    margin-top: 6px;
    color: var(--text-3);
    font-size: 11px;
}

.persona-box {
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 12px;
    color: var(--text-2);
    font-size: 11px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.preview-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.preview-actions > Button,
.preview-actions__btn {
    width: 48.5%;
    margin-right: 8px;
    margin-bottom: 8px;
}

.preview-actions > Button.is-last,
.preview-actions__btn.is-last {
    margin-right: 0;
}

.preview-actions--compact > Button {
    width: 48.5%;
    margin-bottom: 0;
}

.persona-editor {
    flex-direction: column;
    margin-top: 10px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 10px;
}

.persona-edit-field {
    height: 96px;
    margin-bottom: 10px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
}

.persona-edit-field > #unity-text-input {
    background-color: transparent;
    border-width: 0;
    padding: 12px;
    color: var(--text-2);
    font-size: 11px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Regular.ttf");
}

.customize {
    margin-top: 12px;
    color: var(--text-2);
    padding-top: 4px;
}

.customize > .unity-foldout__content {
    margin-top: 8px;
    padding-top: 2px;
}

.customize__group {
    margin-top: 10px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    padding: 10px;
}

.avatar-preview-3d-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--bg-0);
}

.avatar-display-setting {
    min-height: 20px;
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.avatar-display-setting__label {
    flex-grow: 1;
    color: var(--text-2);
    font-size: 11px;
}

.avatar-display-setting__value {
    min-width: 44px;
    color: var(--text-1);
    font-size: 11px;
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/Fonts/GeistMono/GeistMono-Medium.ttf");
}

.avatar-display-slider {
    height: 22px;
}

.avatar-display-slider .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    background-color: var(--bg-4);
}

.avatar-display-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 7px;
    background-color: var(--text-0);
}

.avatar-display-settings__hint {
    margin-top: 8px;
    color: var(--text-3);
    font-size: 10px;
    white-space: normal;
}

.avatar-display-reset {
    align-self: flex-start;
    margin-top: 10px;
}

.customize__emoji-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.customize__emoji-btn {
    width: 34px;
    height: 30px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: var(--bg-2);
}

.customize__emoji-btn.is-active {
    border-color: var(--accent);
    background-color: var(--accent-soft);
}
.companion-window-card {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    min-height: 58px;
    padding: 10px 14px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: var(--r-lg);
    background-color: var(--bg-1);
}

.companion-window-card__state-dot {
    width: 9px;
    height: 9px;
    margin-right: 11px;
    border-radius: 5px;
    background-color: var(--text-3);
}

.companion-window-card--running .companion-window-card__state-dot {
    background-color: #55d68b;
}

.companion-window-card--failed .companion-window-card__state-dot {
    background-color: #e26372;
}

.companion-window-card__copy {
    flex-grow: 1;
    margin-right: 10px;
}

.companion-window-card__title {
    color: var(--text-0);
    font-size: 14px;
    -unity-font-style: bold;
}

.companion-window-card__status {
    color: var(--text-3);
    font-size: 11px;
    margin-top: 2px;
}

.companion-settings-overlay {
    position: absolute;
}

.companion-settings-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.companion-settings-modal {
    width: 480px;
    max-width: 94%;
    padding: 22px;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: var(--r-xl);
    background-color: var(--bg-1);
}

.companion-settings-modal__head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 12px;
}

.companion-settings-modal__copy,
.companion-settings-modal__scale,
.companion-settings-modal__scale > Slider {
    flex-grow: 1;
}

.companion-settings-modal__title {
    color: var(--text-0);
    font-size: 16px;
    -unity-font-style: bold;
}

.companion-settings-modal__subtitle,
.companion-settings-modal__hint {
    color: var(--text-3);
    font-size: 11px;
    margin-top: 3px;
    white-space: normal;
}

.companion-settings-modal__close {
    min-width: 32px;
    margin-left: 10px;
}

.companion-settings-modal__options {
    padding: 12px 14px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: var(--line-1);
    border-radius: var(--r-lg);
    background-color: var(--bg-2);
}

.companion-settings-modal__section-title {
    color: var(--text-0);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.companion-settings-modal__options > * {
    margin-bottom: 6px;
}

.companion-setting-toggle {
    min-height: 30px;
    color: var(--text-1);
    font-size: 12px;
}

.companion-setting-toggle .unity-toggle__label,
.companion-setting-toggle .unity-base-field__label {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 12px;
    color: var(--text-1);
}

.companion-setting-toggle .unity-toggle__input,
.companion-setting-toggle .unity-base-field__input {
    width: 36px;
    min-width: 36px;
    height: 20px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: auto;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 10px;
    background-color: var(--bg-4);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

.companion-setting-toggle:checked .unity-toggle__input,
.companion-setting-toggle:checked .unity-base-field__input {
    border-color: var(--accent);
    background-color: var(--accent);
}

.companion-setting-toggle .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin: 2px;
    border-width: 0;
    border-radius: 7px;
    background-color: var(--text-2);
    background-image: none;
}

.companion-setting-toggle:checked .unity-toggle__checkmark {
    translate: 16px 0;
    background-color: rgb(255, 255, 255);
}

.companion-monitor-button {
    min-height: 30px;
    justify-content: flex-start;
    margin-top: 2px;
}

.companion-settings-modal__scale {
    min-height: 42px;
    padding-top: 4px;
}

.companion-settings-modal__scale-label {
    height: 18px;
    color: var(--text-2);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.companion-scale-slider {
    height: 22px;
}

.companion-scale-slider .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    background-color: var(--bg-4);
}

.companion-scale-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 7px;
    background-color: var(--text-0);
}

.companion-settings-modal__actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: 10px;
}

.companion-settings-modal__actions > .btn {
    margin-left: 6px;
    margin-bottom: 6px;
    min-height: 30px;
}
