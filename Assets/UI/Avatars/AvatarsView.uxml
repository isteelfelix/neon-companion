<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="../Theme/Tokens.uss" />
    <ui:Style src="../Theme/Components.uss" />
    <ui:Style src="AvatarsView.uss" />
    <ui:Style src="../Main/MainView.Tints.uss" />

    <ui:VisualElement name="avatars-area" class="page avatars-page">

        <ui:VisualElement class="page__head">
            <ui:VisualElement class="page__head-copy">
                <ui:Label name="avatars-page-title" text="Аватары" class="page__title" />
                <ui:Label name="avatars-page-subtitle" text="Выберите готовый образ или импортируйте локальный 2D, sprite-sheet, 3D или VRM-профиль." class="page__subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="page__actions">
                <ui:Button name="avatar-open-folder-btn" text="Открыть папку" class="btn" />
                <ui:Button name="avatar-upload-btn" text="Загрузить" class="btn btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="viewmode-row">
            <ui:Button name="viewmode-static-btn" class="viewmode-btn viewmode-btn--active">
                <ui:Label text="Статика" />
            </ui:Button>
            <ui:Button name="viewmode-animated-btn" class="viewmode-btn">
                <ui:Label text="Анимация" />
            </ui:Button>
            <ui:Button name="viewmode-3d-btn" class="viewmode-btn">
                <ui:Label text="3D" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement name="avatar-filterrow" class="filterrow">
            <ui:Button name="avatar-filter-all-btn" class="filterchip filterchip--active">
                <ui:Label text="Все" />
                <ui:Label name="avatar-filter-all-count" text="0" class="filterchip__count" />
            </ui:Button>
            <ui:Button name="avatar-filter-standard-btn" class="filterchip">
                <ui:Label text="Стандартные" />
                <ui:Label name="avatar-filter-standard-count" text="0" class="filterchip__count" />
            </ui:Button>
            <ui:Button name="avatar-filter-gradient-btn" class="filterchip">
                <ui:Label text="Градиентные" />
                <ui:Label name="avatar-filter-gradient-count" text="0" class="filterchip__count" />
            </ui:Button>
            <ui:Button name="avatar-filter-minimal-btn" class="filterchip">
                <ui:Label text="Минимализм" />
                <ui:Label name="avatar-filter-minimal-count" text="0" class="filterchip__count" />
            </ui:Button>
            <ui:Button name="avatar-filter-custom-btn" class="filterchip">
                <ui:Label text="Свои" />
                <ui:Label name="avatar-filter-custom-count" text="0" class="filterchip__count" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement class="avatar-split">
            <ui:ScrollView name="gallery-container" class="gallery-container" mode="Vertical">

            <ui:VisualElement name="gallery-static" class="gallery">

                <ui:VisualElement name="avtile-neon" class="avtile avtile--selected avtile--neon">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Неон" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-yorha-2b" class="avtile avtile--yorha-2b">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="YoRHa 2B" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-aurora" class="avtile avtile--aurora">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Аврора" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-ember" class="avtile avtile--ember">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Эмбер" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-glass" class="avtile avtile--glass">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Гласс" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-flora" class="avtile avtile--flora">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Флора" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-mono" class="avtile avtile--mono">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Моно" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-cobalt" class="avtile avtile--cobalt">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Кобальт" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-rose" class="avtile avtile--rose">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:Label text="Роуз" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avtile-upload" class="avtile avtile--upload">
                    <ui:VisualElement class="avtile__upload">
                        <ui:VisualElement class="icon icon--upload" />
                        <ui:Label name="avatar-import-tile-label" text="Импортировать аватар" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Animated gallery -->
            <ui:VisualElement name="gallery-animated" class="gallery">
                <ui:VisualElement name="avtile-neon-animated" class="avtile avtile--neon-animated">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:VisualElement class="avtile__anim-badge">
                        <ui:Label text="ANIM" />
                    </ui:VisualElement>
                    <ui:Label text="Неон" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="avtile-yorha-2b-animated" class="avtile avtile--yorha-2b-animated">
                    <ui:VisualElement class="avtile__vignette" />
                    <ui:VisualElement class="avtile__anim-badge">
                        <ui:Label text="ANIM" />
                    </ui:VisualElement>
                    <ui:Label text="YoRHa 2B" class="avtile__name" />
                    <ui:VisualElement class="avtile__badge">
                        <ui:VisualElement class="icon icon--check" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Generic 3D and catalog-only VRM profiles are inserted here at runtime. -->
            <ui:VisualElement name="gallery-3d" class="gallery">
                <ui:Label name="avatar-gallery-3d-hint" text="Импортируйте GLB/glTF или добавьте VRM в локальный каталог." class="gallery-empty-hint" />
            </ui:VisualElement>

            </ui:ScrollView> <!-- end gallery-container -->

            <ui:VisualElement class="previewcard">
                <ui:ScrollView name="avatar-preview-scroll" class="preview-scroll" mode="Vertical">
                    <ui:VisualElement name="preview-hero" class="preview-hero preview-hero--neon">
                        <ui:Label name="preview-title" text="Неон" class="preview-hero__title" />
                        <ui:Label name="preview-tag" text="стандартный" class="preview-hero__tag" />
                    </ui:VisualElement>

                    <ui:Foldout name="avatar-persona-foldout" text="Персона" class="customize" value="false">
                        <ui:VisualElement name="preview-persona-state-row" class="persona-state">
                            <ui:Label name="preview-persona-state-badge" text="Статус инструкций" class="persona-state__badge" />
                            <ui:Label name="preview-persona-state-help" text="Текст ниже попадёт в system prompt при применении аватара." class="persona-state__help" />
                        </ui:VisualElement>
                        <ui:Label name="preview-persona-label" text="Инструкции аватара" class="label preview-persona-label" />
                        <ui:Label name="preview-persona" text="Неон — спокойный и практичный AI-компаньон разработчика. Отвечает кратко, структурно и по делу." class="persona-box" />
                        <ui:VisualElement class="preview-actions preview-actions--compact">
                            <ui:Button name="preview-edit-persona-btn" text="Изменить" class="btn" />
                            <ui:Button name="preview-reset-persona-btn" text="Сбросить инструкции" class="btn is-last" />
                        </ui:VisualElement>
                        <ui:VisualElement name="persona-editor-panel" class="persona-editor">
                            <ui:TextField name="persona-edit-field" multiline="true" class="persona-edit-field" />
                            <ui:VisualElement class="preview-actions preview-actions--compact">
                                <ui:Button name="persona-save-btn" text="Сохранить" class="btn btn--primary" />
                                <ui:Button name="persona-cancel-btn" text="Отмена" class="btn is-last" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Foldout>

                    <ui:Foldout name="avatar-customization-foldout" text="Кастомизация" class="customize" value="false">
                        <ui:VisualElement class="customize__group">
                            <ui:Label text="Эмодзи" class="label" />
                            <ui:VisualElement name="customize-emoji-grid" class="customize__emoji-grid" />
                        </ui:VisualElement>
                        <ui:VisualElement class="preview-actions preview-actions--compact">
                            <ui:Button name="customize-save-btn" text="Сохранить" class="btn btn--primary" />
                            <ui:Button name="customize-cancel-btn" text="Отмена" class="btn is-last" />
                        </ui:VisualElement>
                    </ui:Foldout>

                    <ui:Foldout name="avatar-capabilities-foldout" text="Возможности" class="customize capability-card" value="true">
                        <ui:Label name="avatar-capability-type" text="Тип: статичный 2D" class="capability-card__title" />
                        <ui:Label name="avatar-capability-render" text="Отображение: доступно" class="capability-card__fact" />
                        <ui:Label name="avatar-capability-animation" text="Анимация: недоступна" class="capability-card__fact" />
                        <ui:Label name="avatar-capability-lipsync" text="Липсинк: недоступен" class="capability-card__fact" />
                        <ui:Label name="avatar-capability-evidence" text="Проверка: встроенный профиль" class="capability-card__evidence" />
                        <ui:Label name="avatar-capability-diagnostic" text="" class="capability-card__diagnostic" />
                    </ui:Foldout>

                    <ui:VisualElement name="preview-actions-row" class="preview-actions">
                        <ui:Button name="preview-delete-avatar-btn" text="Удалить" class="btn btn--danger preview-actions__btn" />
                        <ui:Button name="preview-apply-btn" text="Применить" class="btn btn--primary preview-actions__btn is-last" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="avatar-import-overlay" class="avatar-import-overlay">
            <ui:VisualElement class="avatar-import-scrim" />
            <ui:ScrollView class="avatar-import-dialog" mode="Vertical">
                <ui:VisualElement class="avatar-import-head">
                    <ui:VisualElement>
                        <ui:Label name="avatar-import-title" text="Импорт аватара" class="avatar-import-title" />
                        <ui:Label name="avatar-import-subtitle" text="Выберите backend и проверьте возможности до сохранения." class="avatar-import-subtitle" />
                    </ui:VisualElement>
                    <ui:Button name="avatar-import-close-btn" text="×" class="avatar-import-close" />
                </ui:VisualElement>

                <ui:VisualElement class="avatar-import-types">
                    <ui:Button name="avatar-import-static-btn" text="Статичный 2D" class="avatar-import-type avatar-import-type--active" />
                    <ui:Button name="avatar-import-sprite-btn" text="Sprite-sheet" class="avatar-import-type" />
                    <ui:Button name="avatar-import-3d-btn" text="Generic 3D" class="avatar-import-type" />
                    <ui:Button name="avatar-import-vrm-btn" text="VRM" class="avatar-import-type" />
                </ui:VisualElement>

                <ui:Label name="avatar-import-type-help" text="PNG/JPG до 20 МБ и 8192 × 8192." class="avatar-import-help" />
                <ui:VisualElement class="avatar-import-source-row">
                    <ui:Label name="avatar-import-source" text="Файл не выбран" class="avatar-import-source" />
                    <ui:Button name="avatar-import-choose-btn" text="Выбрать файл" class="btn" />
                </ui:VisualElement>

                <ui:VisualElement class="avatar-import-preview-row">
                    <ui:VisualElement name="avatar-import-preview-box" class="avatar-import-preview-box">
                        <ui:Image name="avatar-import-preview-image" class="avatar-import-preview-image" />
                        <ui:Label name="avatar-import-preview-placeholder" text="Предпросмотр" class="avatar-import-preview-placeholder" />
                    </ui:VisualElement>
                    <ui:VisualElement class="avatar-import-capabilities capability-card">
                        <ui:Label name="avatar-import-capability-title" text="Проверенные возможности" class="capability-card__title" />
                        <ui:Label name="avatar-import-capability-render" text="Отображение: —" class="capability-card__fact" />
                        <ui:Label name="avatar-import-capability-animation" text="Анимация: —" class="capability-card__fact" />
                        <ui:Label name="avatar-import-capability-lipsync" text="Липсинк: —" class="capability-card__fact" />
                        <ui:Label name="avatar-import-capability-scene" text="Сцена: —" class="capability-card__fact" />
                        <ui:Label name="avatar-import-diagnostic" text="Выберите файл для проверки." class="capability-card__diagnostic" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="avatar-import-mapping" class="avatar-import-mapping">
                    <ui:Label name="avatar-import-mapping-title" text="Сопоставление состояния и клипа" class="label" />
                    <ui:Label name="avatar-import-mapping-help" text="Указывайте только имена клипов, найденные в файле." class="avatar-import-help" />
                    <ui:VisualElement class="avatar-import-mapping-grid">
                        <ui:TextField name="avatar-import-clip-idle" label="idle" class="avatar-import-clip" />
                        <ui:TextField name="avatar-import-clip-thinking" label="thinking" class="avatar-import-clip" />
                        <ui:TextField name="avatar-import-clip-talking" label="talking" class="avatar-import-clip" />
                        <ui:TextField name="avatar-import-clip-listening" label="listening" class="avatar-import-clip" />
                        <ui:TextField name="avatar-import-clip-smile" label="smile" class="avatar-import-clip" />
                        <ui:TextField name="avatar-import-clip-confused" label="confused" class="avatar-import-clip" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="avatar-import-actions">
                    <ui:Button name="avatar-import-cancel-btn" text="Отмена" class="btn" />
                    <ui:Button name="avatar-import-save-btn" text="Сохранить в каталог" class="btn btn--primary is-last" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
