  <assembly fullname="VRM10.MToon10" preserve="all" />
  <assembly fullname="VrmLib" preserve="all" />
  <assembly fullname="FastSpringBone10" preserve="all" />
  <assembly fullname="UniGLTF" preserve="all" />
  <assembly fullname="UniGLTF.Utils" preserve="all" />
  <assembly fullname="UniGLTF.UniUnlit" preserve="all" />
  <assembly fullname="UniHumanoid" preserve="all" />
</linker>
